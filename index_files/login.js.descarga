                function obtenerLimites(regex) {
                    const matches = regex.source.match(/\{(\d+),(\d+)?\}/);
                    return {
                        min: matches ? parseInt(matches[1]) : 0,
                        max: matches && matches[2] ? parseInt(matches[2]) : Infinity
                    };
                }

                function validate(formConfig, id, value) {
                    const config = formConfig[id];
                    const limites = obtenerLimites(config.regex);
                    if (value.length === 0) {
                        return field_required_login;
                    }
                    if (value.length < limites.min) {
                        return least_x_characters.replace("{1}", limites.min);
                    }
                    if (value.length > limites.max) {
                        return more_than_x_characters.replace("{1}", limites.max);
                    }
                    if (!config.regex.test(value)) {
                        return password_minimum_two_letters_numbers_server;
                    }
                    return "";
                }

                function initValidator({ formRoot, formConfig, buttonId, errorSuffix = '-error' }) {
                    const status = {};
                    Object.keys(formConfig).forEach(k => status[k] = false);

                    function updateButton() {
                        const btn = formRoot.querySelector(`#${buttonId}`);
                        if (!btn) return;
                        const isReady = Object.values(status).every(v => v === true);
                        btn.disabled = !isReady;
                    }

                    Object.keys(formConfig).forEach(id => {
                        const input = formRoot.querySelector(`#${id}`);
                        if (!input) {
                            return;
                        }
                        const errorDisplay = formRoot.querySelector(`#${id}${errorSuffix}`);
                        const divError = formRoot.querySelector(`#${id} ~ .div-error`);

                        input.addEventListener('input', (e) => {
                            const errorMessage = validate(formConfig, id, e.target.value);

                            if (errorMessage) {
                                if (errorDisplay) errorDisplay.innerText = errorMessage;
                                input.classList.add('invalid');
                                if (divError) divError.style.display = "block";
                                status[id] = false;
                            } else {
                                if (errorDisplay) errorDisplay.innerText = "";
                                input.classList.remove('invalid');
                                if (divError) divError.style.display = "none";
                                status[id] = true;
                            }
                            updateButton();
                        });

                        input.addEventListener('blur', (e) => {
                            const errorMessage = validate(formConfig, id, e.target.value);
                            if (errorDisplay) errorDisplay.innerText = errorMessage;
                            if (errorMessage) input.classList.add('invalid');
                        });

                        status[id] = false;
                    });

                    updateButton();

                    return {
                        updateButton,
                        getStatus: () => ({ ...status })
                    };
                }

                const loginFormConfig = {
                    'input-user-name': { regex: /^.{1,128}$/, name: "usuario" },
