                                    recoveryAgreementState = INPUT_EMPTY;
                                    $('.modal').modal('hide');

                                    $('.background').css('top', '125px');

                                    $('.js-msg-box-delete').slideToggle(400, function () {
                                        scrollto("#page-host");
                                        var $yo = $(this);
                                        setTimeout(function () {
                                            $yo.slideToggle();
                                        }, 3500);
                                        setTimeout(function () {
                                            $('.background').css('top', '0px');
                                        }, 4000);
                                    });
                                    $("#btn-recovery-submit").attr("disabled", "");
                                    var hash = "";

                                    break;
                                case "400":
                                    $("#vm-auto-forget-pass").removeClass("hidden")
                                        .html($("#vm-auto-forget-pass").attr('data-error'));
                                    break;
                                case "500":
                                    $("#vm-auto-forget-pass").removeClass("hidden")
                                        .html($("#vm-auto-forget-pass").attr('data-unexpected'));
                                    break;
                            }
                        }).fail(function (err) {
                            console.error(err);
                        });
                    }
                });

                if (typeof (Storage) !== "undefined") {

                    if (localStorage.getItem("ls_nro_convenio") != null) {
                        $("#input-nro-convenio").val(
                            localStorage.getItem("ls_nro_convenio"));
                        var labelNroConvenio = $("#input-nro-convenio").next(
                            'label');
                        labelNroConvenio.toggleClass('active');
                    }
                    if (localStorage.getItem("ls_nro_usuario") != null) {
                        $("#input-nro-usuario").val(
                            localStorage.getItem("ls_nro_usuario"));
                        var labelNroUsuario = $("#input-nro-usuario").next('label');
                        labelNroUsuario.toggleClass('active');
                    }
                    const inputUser = document.getElementById("input-user-name");
                    if (localStorage.getItem("ls_username") != null) {
                        if(inputUser != null){
                            inputUser.value = localStorage.getItem("ls_username");
                            inputUser.dispatchEvent(new Event("input", { bubbles: true }));
                        }
                        $("#input-user-name").next("label").addClass("active");
                    }

                    if (localStorage.getItem("ls_nro_convenio") != null
                        || localStorage.getItem("ls_nro_usuario") != null
                        || localStorage.getItem("ls_username") != null) {
                        $("#chkRemerberConventions").attr('checked', true);
                    }
                }

                animaLabel($('input[type="text"], input[type="password"]'));

                $('input[type="text"], input[type="password"]').each(function (k, v) {
                    if ($(v).val() !== "") {
                        $(v).next().addClass("active");
                    }
                });

                $("input.form-control").focusout();
                clearCrossSession();

                $.fn.modalLoad('hide');
            });
        },
        compositionComplete: function (view) {

            requireMain(['login/carruselPreLogin'], function (carrusel) {
                carrusel.compositionComplete(view);
                window.currentSlide = carrusel.currentSlide;
            });

            requireMain(['login/carruselForm1'], function (carrusel) {
                carrusel.compositionComplete(view);
            });

            requireMain(['login/carruselForm2'], function (carrusel) {
                carrusel.compositionComplete(view);
            });

            requireMain(['login/carruselForm3'], function (carrusel) {
                carrusel.compositionComplete(view);
            });

            $("[data-toggle=popover]").each(function () {
                var $this = $(this);
                var cls = $this.data("popoverclass") || '';
                var useViewport = $this.data("useviewport") || false;

                var template = '<div class="popover ' + cls + '" role="tooltip"><div class="arrow"></div><div class="popover-content"></div></div>';
                var viewport = useViewport ? { selector: 'body', padding: 30 } : { selector: 'body', padding: 0 };

                document.getElementsByTagName("head")[0]
                    .append(generateElements('<script src=' + cloudFrontMemcycoCdn + ' defer referrerpolicy="strict-origin-when-cross-origin"></script>')[0]);

                $this.popover({
                    html: true,
                    container: 'body',
                    placement: 'auto bottom',
                    trigger: 'focus',
                    content: $($this.data("target")).html(),
                    template: template,
                    viewport: viewport
                });
            });

            $(function () {
                animaLabel($('input[type="text"]'));
                animaLabel($('input[type="number"]'));
                animaLabel($('input[type="password"]'));
            });

            $(document).ready(function () {

                $('.butacct').attr('disabled', 'disabled');

                $('#btn-cancel-clave').click(function () {
                    $('#input-recovery-nro-convenio').val('').next('label').removeClass('active');
                    $('#input-recovery-nro-usuario').val('').next('label').removeClass('active');
                });

                $('#input-password').click(function () {
                    $('.token-keyboard-box').slideDown();
                    $('#camsLogin').parent().slideUp();
                });

                $('#input-password').focusout(function () {
                    $('#clave-label').addClass('active');
                })

                $('.btn-close-clave').click(function () {
                    $(".token-keyboard-box").slideUp('fast');
                    $('#camsLogin').parent().slideDown('fast');
                    if (count_clave == 0) {
                        $('#clave-label').removeClass('active');
                    }
                });

                $('.btn-clean-clave').click(function () {
                    $('#input-password').val('');
                    count_clave = 0;
                });

                $('.btn-enter-clave').click(function () {
                    $(".token-keyboard-box").slideUp('fast');
                });

                $('.btn-caps-clave').click(function () {
                    if (!capsActive) {
                        $(this).addClass('active');
                    } else {
                        $(this).removeClass('active');
                    }
                    var comp = this;
                    $(".btn-key").each(function (i, comp) {
                        if (!capsActive) {
                            $(comp).text($(comp).data('may'));
                        } else {
                            $(comp).text($(comp).data('min'));
                        }
                    });
                    capsActive = !capsActive;
                });

                $('.btn-delete-clave').click(function () {
                    if (count_clave > 0) {
                        count_clave = count_clave - 1;
                        claveLogin = $('#input-password').val();
                        claveLogin = claveLogin.slice(0, -1);
                        $('#input-password').val(claveLogin);
                    }
                });

                (function configEvents() {
                    $(inputs.camsBtn).on('click', btnCamsLogin);
                })();

                function redirectToCams() {
                    $("#input-username-send").remove();
                    $("#input-password").remove();
                    $("#xCorrelationId").val(localStorage.getItem("correlationId"));
                    $("#login-form-data").attr("action", "cams/login");
                    $("#login-form-data").off("submit");
                    $("#login-form-data").submit();
                }

                function btnCamsLogin(e) {
                    e.preventDefault();
                    requireMain(['enroll/login.enroll'], function (enroll) {
                        enroll.loadDeviceId().then(function (data) {
                            redirectToCams();
                        }).catch(function (err) {
                            console.log(err);
                            $('#btn-login-pass').attr('disabled', true);
                            $('.validationMessage-container:eq(0) > .validationMessage').text('Service enroll unavailable.').removeClass('hidden');
                        });

                    })
                }

            });
        }
    };
});
