                var patter_user = new RegExp('^\\d{' + SIZE_INPUT_USER + '}$', 'i');
                var patter_password_special = new RegExp('^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[!@#$%^&*()])[A-Za-z\\d!@#$%^&*()]{' + SIZE_INPUT_WORD + ',}$');
                var patter_password = new RegExp('[a-zA-Z|\\d]{' + SIZE_INPUT_WORD + '}', 'i');

                function validateUserName(value) {
                    return patter_username.test(value);
                }

                function validateAgreement(value) {
                    return patter_agreement.test(value);
                }

                function validateUser(value) {
                    return patter_user.test(value);
                }

                function validatePassword(value) {
                    var haSpecialChar = /[!@#$%^&*()]/.test(value);
                    return haSpecialChar ? patter_password_special.test(value) : patter_password.test(value);
                }

