                const iconRememberUser = document.getElementById("info-remember-username");
                const tooltipRememberUser = document.getElementById("tooltip-remember-username");
                const tooltipCloseBtn = tooltipRememberUser?.querySelector(".tooltip-close");

                iconRememberUser?.addEventListener("click", (e) => {
                    e.stopPropagation();
                    tooltipRememberUser?.classList.toggle("is-open");
                });

                tooltipCloseBtn?.addEventListener("click", (e) => {
                    e.stopPropagation();
                    tooltipRememberUser?.classList.remove("is-open");
                });

                tooltipRememberUser?.addEventListener("click", (e) => {
                    e.stopPropagation();
                });

                document.addEventListener("click", (e) => {
                    if (!iconRememberUser?.contains(e.target) && !tooltipRememberUser?.contains(e.target)) {
