                function changeOfEye(input, event) {
                    const isPassword = input.attr("type") === "password";
                    input.attr("type", isPassword ? "text" : "password");
                    event.attr("src", isPassword ? "../nuevotbk/resources/img/icon-eye.svg" : "../nuevotbk/resources/img/icon-eye-hide.svg");
                }

                $(document).on("click", "#icon-password-eye", function () {
                    changeOfEye($("#input-password-login"), $(this));
                });

                $(document).on("click", "#icon-token-eye", function () {
