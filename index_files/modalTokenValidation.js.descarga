  // Mapea la respuesta del backend a los spans existentes
  Instance.prototype._processResponse = function (response) {
    var code = this.options.parseCode(response);
    var msg = this.options.parseMsg(response);

    if (code === "200") {
      if (typeof this.options.onSuccess === "function") {
        this.options.onSuccess(response, this.api());
      }
      return;
    }

    if (code === "400") {
      // Inválido (pwd/token) — mostramos ambos mensajes 400 para no revelar cuál falló
      this._showFor(this.$pwd, this.$msgPwdErr400, msg);
      this._showFor(this.$token, this.$msgTokErr400, msg);
      if (typeof this.options.onClientError === "function") {
        this.options.onClientError(response, this.api());
      }
      return;
    }

    // Otros (5xx, etc.)
    var fallback = msg || "No se pudo completar la validación.";
    this._showFor(this.$pwd, this.$msgPwdErr, fallback);
    this._showFor(this.$token, this.$msgTokErr, fallback);
    if (typeof this.options.onServerError === "function") {
      this.options.onServerError(response, this.api());
    }
  };

  // Mostrar mensaje y vincular aria-describedby
  Instance.prototype._showFor = function ($input, $msg, text) {
    if (!$msg.length) return;
    if (text) $msg.text(text);
    $msg.removeClass("hidden");
    if ($input && $input.length) {
      $input.attr("aria-invalid", "true");
      $input.attr("aria-describedby", $msg.attr("id"));
      $input.focus();
    }
  };

  Instance.prototype._networkError = function () {
    var text =
      (this.options.messages && this.options.messages.netError) ||
      "Error de red.";
    this._showFor(this.$pwd, this.$msgPwdErr, text);
    this._showFor(this.$token, this.$msgTokErr, text);
  };

  // ---------- API pública por instancia ----------
  Instance.prototype.open = function () {
    // Más seguro durante validación
    this.$modal.modal({ backdrop: "static", keyboard: false, show: true });
  };
  Instance.prototype.close = function () {
    this.$modal.modal("hide");
  };
  Instance.prototype.reset = function () {
    this.$pwd.val("");
    this.$token.val("");
    this._hideAllMessages();
    this._updateMessages();
    this._updateSubmitState();
  };
  Instance.prototype.destroy = function () {
    this._unbind();
    this.$root.removeData("mtvInstance");
  };

  // Permite forzar muestra de error desde la vista:
  // api.showError({ field: 'password'|'token'|'global', type: 'invalid'|'unexpected', message })
  Instance.prototype.showError = function (err) {
    this._hideAllMessages();
    var type = (err && err.type) || "unexpected";
    var text = err && err.message;
    if (!err || err.field === "global") {
      this._showFor(
        this.$pwd,
        type === "invalid" ? this.$msgPwdErr400 : this.$msgPwdErr,
        text
      );
      this._showFor(
        this.$token,
        type === "invalid" ? this.$msgTokErr400 : this.$msgTokErr,
        text
      );
      return;
    }
    if (err.field === "password") {
      this._showFor(
        this.$pwd,
        type === "invalid" ? this.$msgPwdErr400 : this.$msgPwdErr,
        text
      );
      return;
    }
    if (err.field === "token") {
      this._showFor(
        this.$token,
        type === "invalid" ? this.$msgTokErr400 : this.$msgTokErr,
        text
      );
      return;
    }
  };

  Instance.prototype.api = function () {
    return {
      open: this.open.bind(this),
      close: this.close.bind(this),
      reset: this.reset.bind(this),
      destroy: this.destroy.bind(this),
      root: this.$root,
      showError: this.showError.bind(this),
      lock: this.lock.bind(this),
      unlock: this.unlock.bind(this),
      busyWhile: this.busyWhile.bind(this),
    };
  };

  // ---------- Manager expuesto (attach/get) ----------
  var Manager = {
    attach: function (ctx, options) {
      var $ctx = ctx instanceof $ ? ctx : $(ctx);
      var existing = this.get($ctx);
      if (existing) return existing;
      var inst = new Instance($ctx, options);
      return inst && inst.api ? inst.api() : null;
    },
    get: function (ctx) {
      var $ctx = ctx instanceof $ ? ctx : $(ctx);
      var $root = $ctx.is("#modalTokenValidation")
        ? $ctx
        : $ctx.find("#modalTokenValidation");
      var inst = $root.data("mtvInstance");
      return inst ? inst.api() : null;
    },
  };

  return Manager;
});
