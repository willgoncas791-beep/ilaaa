        url: url,
        requireFunction: opt.request.requireFunction,
        module_url: opt.request.moduleUrl,
        dataHttp: payload,
        method: method,
        contentType: contentType,
        validResponse: function (response) {
          self._processResponse(response);
        },
        error: function () {
          self._networkError();
        },
        complete: onComplete,
      });
