  Instance.prototype.busyWhile = function (promise, message) {
    var self = this;
    this.lock(message);
    return promise.always(function () {
      self.unlock();
    });
  };

  // Sanitización/validación
  Instance.prototype._sanitizeToken = function () {
    var clean = (this.$token.val() || "")
      .replace(/\D/g, "")
      .slice(0, TOKEN_LEN);
    if (this.$token.val() !== clean) this.$token.val(clean);
    return clean;
  };

  Instance.prototype._isPasswordValid = function () {
    var v = this.$pwd.val() || "";
    return v.length >= MIN_PWD && v.length <= MAX_PWD;
  };

  Instance.prototype._isTokenValid = function () {
    return this._sanitizeToken().length === TOKEN_LEN;
  };

  // Mensajes y ARIA
  Instance.prototype._hideAllMessages = function () {
    this.$msgPwdHint.addClass("hidden");
    this.$msgPwdErr400.addClass("hidden");
    this.$msgPwdErr.addClass("hidden");
    this.$msgTokHint.addClass("hidden");
    this.$msgTokErr400.addClass("hidden");
    this.$msgTokErr.addClass("hidden");
    this.$pwd.removeAttr("aria-describedby");
    this.$token.removeAttr("aria-describedby");
  };

  Instance.prototype._toggleHidden = function ($el, hidden) {
    if (!$el || !$el.length) return;
    $el.toggleClass("hidden", hidden);
  };

  Instance.prototype._linkDescribedBy = function ($input, $msg) {
    if (!$input || !$input.length || !$msg || !$msg.length) return;
    if ($msg.hasClass("hidden")) {
      $input.removeAttr("aria-describedby");
    } else {
      $input.attr("aria-describedby", $msg.attr("id"));
    }
  };

  Instance.prototype._updateMessages = function () {
    // Mostrar hints sólo cuando el campo tiene contenido y está inválido
    var showPwdHint =
      !this._isPasswordValid() && !!(this.$pwd.val() || "").length;
    var showTokHint =
      !this._isTokenValid() && !!(this.$token.val() || "").length;

    this._toggleHidden(this.$msgPwdHint, !showPwdHint);
    this._toggleHidden(this.$msgTokHint, !showTokHint);

    // Accesibilidad
    this.$pwd.attr("aria-invalid", !this._isPasswordValid());
    this.$token.attr("aria-invalid", !this._isTokenValid());
    this._linkDescribedBy(this.$pwd, this.$msgPwdHint);
    this._linkDescribedBy(this.$token, this.$msgTokHint);
  };

  Instance.prototype._updateSubmitState = function () {
    var enable = this._isPasswordValid() && this._isTokenValid();
    this.$submit.prop("disabled", !enable);
  };

  Instance.prototype._handleSubmit = function () {
    var opt = this.options;
    if (this.$submit.prop("disabled")) return;

    // Validación cliente final
    if (!this._isPasswordValid() || !this._isTokenValid()) {
      // Fuerza hints en ambos si faltan reglas
      this._updateMessages();
      (!this._isPasswordValid() ? this.$pwd : this.$token).focus();
      return;
    }

    // Busy + limpiar mensajes
    this._setBusy(true);
    this._hideAllMessages();

    var ctx = {
      pwd: this.$pwd.val(),
      token: this._sanitizeToken(),
      $root: this.$root,
      api: this.api(),
      action: this.$root.data("action") || "",
    };
    var payload = opt.buildPayload(ctx);
    var self = this;

    var onComplete = function () {
      self._setBusy(false);
      self._updateSubmitState();
    };

    var url =
      typeof opt.request.url === "function"
        ? opt.request.url(ctx)
        : opt.request.url;
    var method =
      typeof opt.request.method === "function"
        ? opt.request.method(ctx)
        : opt.request.method || "POST";
    var contentType =
      typeof opt.request.contentType === "function"
        ? opt.request.contentType(ctx)
        : opt.request.contentType || "application/json";

    if (
      opt.request &&
      typeof $.fn.sendRequire === "function" &&
      opt.request.requireFunction
