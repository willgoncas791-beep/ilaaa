    this.$token && this.$token.off(NS);
    this.$submit && this.$submit.off(NS);
    this.$close && this.$close.off(NS);
    this.$modal &&
      this.$modal.off("hidden.bs.modal" + NS + " shown.bs.modal" + NS);
  };

  // Estado busy del botón submit
  Instance.prototype._setBusy = function (isBusy) {
    if (!this.$submit.length) return;
    if (isBusy) {
      if (!this.$submit.data("orig-html")) {
        this.$submit.data("orig-html", this.$submit.html());
      }
      this.$submit
        .prop("disabled", true)
        .addClass("disabled")
        .html(
          '<span class="glyphicon glyphicon-refresh glyphicon-spin" aria-hidden="true"></span> ' +
            this.$submit.text()
        );
    } else {
      var orig = this.$submit.data("orig-html");
      if (orig) this.$submit.html(orig);
      this.$submit.prop("disabled", false).removeClass("disabled");
    }
  };

  // Overlay y bloqueo integral del modal
  Instance.prototype._ensureBusyOverlay = function () {
    if (this.$busy && this.$busy.length) return;
    // Asegura stacking y posición
    if (this.$modal.css("position") === "static") {
      this.$modal.css("position", "relative");
    }
    this.$busy = $(
      '<div class="mtv-busy-overlay" aria-hidden="true">' +
        '<span class="glyphicon glyphicon-refresh glyphicon-spin" aria-hidden="true"></span>' +
        '<span class="sr-only">Procesando…</span>' +
        "</div>"
    ).hide();
    this.$modal.append(this.$busy);
  };

  Instance.prototype._blockModal = function (flag, message) {
    this._ensureBusyOverlay();

