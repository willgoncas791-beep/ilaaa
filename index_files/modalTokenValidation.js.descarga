      };
    }
  }
})(typeof self !== "undefined" ? self : this, function ($, window, document) {
  "use strict";

  var NS = ".mtv"; // namespace de eventos

  // Reglas (ligadas al HTML/proyecto)
  var MIN_PWD = 8;
  var MAX_PWD = 32;
  var TOKEN_LEN = 6;

  // Opciones sobre-escribibles por vista
  var DEFAULTS = {
    // Dónde llamar para validar
    request: {
      url: null, // <- establecer por vista
      method: "POST",
      contentType: "application/json",
      requireFunction: null, // si usas $.fn.sendRequire con requireFunction/module_url
      moduleUrl: null,
    },
    // Construye el payload para tu backend (ctx: { pwd, token, $root, api })
    buildPayload: function (ctx) {
      return {
        password: ctx.pwd,
        tokenNumber: ctx.token,
        orders: [],
        redirectTo: "",
        numTabSelected: "",
      };
    },
    // Parseadores por si tu backend usa otros nombres
    parseCode: function (response) {
      return String((response && response.code) || "");
    },
    parseMsg: function (response) {
      return response && response.msg ? String(response.msg) : "";
    },

    // Callbacks
    onSuccess: function (/*response, api*/) {},
    onClientError: function (/*response, api*/) {}, // p.ej. 400
    onServerError: function (/*response, api*/) {}, // p.ej. 5xx

    // UX
    messages: {
      netError:
        "No se pudo validar el token. Verifica tu conexión e inténtalo de nuevo.",
    },
    focus: "password", // 'password' | 'token' | 'auto'
  };

  function within($root, id) {
    return $root.find('[id="' + id + '"]');
  }

  // -------- Clase de instancia (una por vista) --------
  function Instance($ctx, options) {
    this.options = $.extend(true, {}, DEFAULTS, options || {});
    this.$root = $ctx.is("#modalTokenValidation")
      ? $ctx
      : $ctx.find("#modalTokenValidation");
    if (!this.$root.length) return; // no está el fragmento en DOM

    // El modal ES el root (bugfix: antes se buscaba #modalValidation, que no existe)
    this.$modal = this.$root;

    // Campos
    this.$pwd = within(this.$root, "inputPasswordValidation");
    this.$token = within(this.$root, "inputTokenValidation");
    // Botones
    this.$submit = within(this.$root, "btnTokenValidation");
    this.$close = within(this.$root, "btnTokenValidationClose");
    // Mensajes
    this.$msgPwdHint = within(this.$root, "camsValidationMessage"); // required/length
    this.$msgPwdErr400 = within(this.$root, "camsValidationMessage2"); // inválido (server)
    this.$msgPwdErr = within(this.$root, "camsValidationMessage3"); // inesperado
    this.$msgTokHint = within(this.$root, "tokenValidationMessage");
    this.$msgTokErr400 = within(this.$root, "tokenValidationMessage2");
    this.$msgTokErr = within(this.$root, "tokenValidationMessage3");

    if (!this.$pwd.length || !this.$token.length || !this.$submit.length) {
      if (window.console)
        console.warn(
          "[mtv] Fragmento incompleto: faltan elementos requeridos."
        );
      return;
    }

    this._init();
  }

  // ---------- Métodos privados ----------
  Instance.prototype._init = function () {
    var self = this;

    // Atributos de inputs
    this.$token.attr({
      maxlength: TOKEN_LEN,
      inputmode: "numeric",
      pattern: "\\d*",
    });
    this.$pwd.attr({ autocomplete: "current-password", maxlength: MAX_PWD });

    // Accesibilidad en contenedores de mensajes
    this.$root.find(".validationMessage-container").attr("aria-live", "polite");

    // Bind/Unbind idempotentes
    this._unbind();
    this._bind();

    // Reset inicial
    this.reset();

    // Eventos del modal
    this.$modal.on("hidden.bs.modal" + NS, function () {
      self.reset();
      self._setBusy(false);
      self._blockModal(false);
      self.$root.removeData("action");
      self.$root.removeData("orders");
    });

    this.$modal.on("shown.bs.modal" + NS, function () {
      // Foco inicial
      var target = self.options.focus;
      if (target === "auto") {
        var which = self.$pwd.val() || "" ? self.$token : self.$pwd;
        which.focus();
      } else if (target === "token") {
        self.$token.focus();
      } else {
        self.$pwd.focus();
      }
    });

    // Guardar instancia
    this.$root.data("mtvInstance", this);
  };

  Instance.prototype._bind = function () {
    var self = this;

    this.$pwd.on("input" + NS, function () {
      self._updateMessages();
      self._updateSubmitState();
    });

    this.$token.on("input" + NS, function () {
      self._sanitizeToken();
      self._updateMessages();
      self._updateSubmitState();
    });

    this.$submit.on("click" + NS, function (e) {
      e.preventDefault();
      self._handleSubmit();
    });

    this.$close.on("click" + NS, function () {
      self.reset();
      self.close();
    });

    // Enter confirma
    this.$pwd.add(this.$token).on("keydown" + NS, function (e) {
      if (e.key === "Enter" && !self.$submit.prop("disabled")) {
        e.preventDefault();
        self.$submit.click();
      }
    });
