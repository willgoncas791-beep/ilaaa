    return;
  }
  // Fallback global
  var api = factory(root.jQuery, root, root.document);
  root.ModalTokenValidation = api;
  if (typeof root.defineMain === "function") {
    root.defineMain("modalTokenValidation", function () {
      return api;
    });
  } else {
    root.__modules = root.__modules || {};
    root.__modules["modalTokenValidation"] = api;
