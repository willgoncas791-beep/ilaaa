var requireMain = requirejs.config({
  baseUrl: staticPath + "/resources/js",
  urlArgs: "v=" + jsVersion,
  waitSeconds: 200,
  paths: {
    text: "lib/text",
    jquery: "lib/jquery-3.7.1.min",
    "jquery-ui": "lib/jquery-ui.min",
    bootstrap: "lib/bootstrap.min",
    hammer: "lib/hammer.min",
    "bootstrap-select": "lib/bootstrap-select.min",
    d3: "lib/d3.min",
    c3: "lib/c3.min",
    forma_pago: "data/forma_pago",
    datepicker_valid: "lib/jquery.ui.datepicker.validation.min",
    forms: "data/forms",
    handlebars: "lib/handlebars-latest",
    moment: "lib/moment",
    "jquery.validated": "lib/jquery.validated",
    utilities: "lib/utilities",
    tbk: "lib/tbk",
    cambioclave: "cambioclave/cambioclave",
    notifications: "notificaciones/890_notificaciones",
    terminos: "terminos/terminos",
    akuTab: "lib/aku-tab",
    scrollto: "lib/scrollto",
    datepicker: "lib/datepicker",
    html2canvas: "lib/html2canvas",
    globalMethods: "tbk/globalMethods",
    requestHome: "tbk/requestHome",
    systemInf: "tbk/systemInf",
    methodsHome: "tbk/methodsHome",
    autocompleteUtil: "tbk/autocompleteUtil",
    modalTokenValidation: "tbk/modalTokenValidation",
    regexUtils: "tbk/regexUtils",
    formsUtil: "tbk/formsUtil",
    orderMethods: "tbk/orderMethods",
    knockout: "lib/knockout-3.4.0",
    table: "data/table",
