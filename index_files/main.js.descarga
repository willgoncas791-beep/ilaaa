  },
  shim: {
    utilities: {
      deps: ["jquery", "bootstrap-select", "moment", "html2canvas", "tbk"],
      exports: "jQuery",
    },
    bootstrap: {
      deps: ["jquery"],
      exports: "jQuery",
    },
    "bootstrap-select": {
      deps: ["bootstrap"],
    },
    c3: {
      deps: ["d3"],
    },
    handlebars: {
      exports: "Handlebars",
    },
    datepicker_valid: {
      deps: ["jquery.validated"],
    },
    html2canvas: {
      deps: ["jquery"],
      exports: "jQuery",
    },
  },
});

require(["jquery"], function($) {
  window.$ = $;
  window.jQuery = $;
});

require(["jquery", "modalTokenValidation"], function ($, modal) {
  modal.init && modal.init();
});
