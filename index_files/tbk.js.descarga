function validateNumberKeyDown(idInput, longitud) {
	var valueBefore = $(idInput).val();
	setTimeout(function() {
		var data = $(idInput).val();
		var isOk = validateNumberText(data, longitud);

		if (!isOk) {
			if (validateNumberText(valueBefore, longitud)) {
				$(idInput).val(valueBefore);
			}
		}
	}, 20);
}

function validateNumberText(valTexto, longitud) {
	var exprEmpty = /^\s+$/;
	if (exprEmpty.test(valTexto)) {
		return false;
	}
	if (valTexto == 127 | valTexto == 8 | valTexto == 0) {
		if (!valTexto.includes(".") && !valTexto.includes(" ")) {
			return true;
		}
	}

	var expr = REG_EXPR_ONLY_NUMERIC;
	var testExpr = expr.test(valTexto);

	if (longitud !== undefined) {
		if (testExpr) {
			if (valTexto.length <= longitud)
				testExpr = true;
			else
				testExpr = false;
		}
	}
	return testExpr;

}

function validarTodayLess(var_date) {
	var d = new Date();
	var dayfield = var_date.split('/')[0];
	var monthfield = var_date.split('/')[1];
	var yearfield = var_date.split('/')[2];
	var_date = new Date(yearfield, monthfield - 1, dayfield);
	if (var_date.getTime() > d.getTime()) {
		return false;
	}
	return true;
}


function formatearNumeroText(valString) {

	var tipoMoneda = valString.slice(0, 4);
	valString = valString.slice(4, valString.length);

	if (valString != "0.00") {
		valString = valString.toString();
		var posicionPuntito = valString.indexOf(".");

		var valDecimal;

		if (posicionPuntito != -1) {
			valDecimal = valString.slice(posicionPuntito + 1,
					posicionPuntito.length);
			if (valDecimal.length == 1) {

				valDecimal = valDecimal + "0";
			}

			valString = valString.slice(0, posicionPuntito);
		}

		while (/(\d+)(\d{3})/.test(valString.toString())) {
			valString = valString.toString().replace(/(\d+)(\d{3})/,
					'$1' + ',' + '$2');
		}

		if (posicionPuntito != -1) {
			valString = valString + "." + valDecimal;
		} else {
			valString = valString + ".00";
		}
	}
	return tipoMoneda + valString;
}

function formatearNumero(valString) {

	if (valString != "0.00") {
		valString = valString.toString();
		var posicionPuntito = valString.indexOf(".");

		var valDecimal;

		if (posicionPuntito != -1) {
			valDecimal = valString.slice(posicionPuntito + 1,
					posicionPuntito.length);
			if (valDecimal.length == 1) {
				valDecimal = valDecimal + "0";
			}

			valString = valString.slice(0, posicionPuntito);
		}

		while (/(\d+)(\d{3})/.test(valString.toString())) {
			valString = valString.toString().replace(/(\d+)(\d{3})/,
					'$1' + ',' + '$2');
		}

		if (posicionPuntito != -1) {
			valString = valString + "." + valDecimal;
		} else {
			valString = valString + ".00";
		}
	}
	return valString;
}

function completeZeros(monto, cantidad) {

	if (monto.length != cantidad) {

		var cantidadZeros = cantidad - monto.length;
		var i;
		var txtZeros = "";

		for (i = 0; i < cantidadZeros; ++i) {
			txtZeros = txtZeros + "0";
		}

		monto = txtZeros + monto;
	}

	return monto;
}

function initDateWithMinDateToday(idFecha) {

	var actualDate = new Date();
	var actualYear = actualDate.getFullYear();
	var actualMonth = actualDate.getMonth();
	var actualDay = actualDate.getDate();

	var afterDate = new Date();
	afterDate = new Date(new Date().setDate(new Date().getDate() + 30));
	var afterYear = afterDate.getFullYear();
	var afterMonth = afterDate.getMonth();
	var afterDay = afterDate.getDate();

	var minDate = new Date(actualYear, actualMonth, actualDay);
	var maxDate = new Date(afterYear, afterMonth, afterDay);

	$(idFecha).datepicker({
		dateFormat : 'dd/mm/yy',
		minDate : minDate,
		maxDate : maxDate
	});

	$(idFecha).attr('value', getTodayDDMMYYYY());

	var isLangSpanish = isSpanishLanguage();

	if (isLangSpanish) {
		convertCalendarSpanish(idFecha);
	}
}

function addDecimalZeros(number, decimals) {
	var numberFormmated;
	var number;
	var zerosTemp = "";
	var index = number.indexOf(".");
	if (index == -1) {
		for (i = 1; i <= decimals; i++) {
			zerosTemp = zerosTemp + "0";
		}
		numberFormmated = number + "." + zerosTemp;
	} else {
		var decimalsTemp = number.split(".")[1].length;
		var zeros = decimals - decimalsTemp;

		for (i = 1; i <= zeros; i++) {
			zerosTemp = zerosTemp + "0";
		}
		numberFormmated = number + zerosTemp;
	}

	return numberFormmated;
}

function validateEmail(email) {
	var regexp = REG_EXP_EMAIL;
	return regexp.test(email);
}

function addEventsNumericValidation(parentInput, input, length, type, excetions) {

	if (type == CODE_NUMERIC_VALIDATION) {
		
		$(parentInput).on("keypress", input, function(event){
			if((event.charCode >= 48 && event.charCode <= 57) || (event.charCode == 0)){
				return true;
			}else {
				return false;
			}
		});
		
		$(parentInput).on("keydown", input, function(event) {
			return validateNumberKeyDown($(input), length);
		});
	}

}

function addEventsAlphabeticValidation(parentInput, input, length, type,
		exceptions) {

	var accept_space = exceptions.space != undefined ? exceptions.space : false;

	if (type == CODE_LETTERS_VALIDATION) {

	} else if (type == CODE_ALPHANUMERIC_VALIDATION) {
		
		$(parentInput).on("keypress", input, function(event){
			var arroba = '64';
			if(event.charCode == arroba){
				return false;
			}else {
				return true;
			}
		});
		
		$(parentInput).on("keydown", input, function(event) {
			if (allowSpecialCharacters(event)) {
				return true;
			} else {
				var limite = $(input).val().length < length ? true : false;
				if (limite) {
					return validarAlfanumericosKeyDown($(input), accept_space);
				} else {
					return false;
				}
			}

		});
	}
}

function allowSpecialCharacters(event) {
	// 8 == delete , 46 == suprimir, 17 = ctrl,
	if (event.keyCode == 8 || event.keyCode == 46 || event.keyCode == 17) {
		return true;
	} else {
		return false;
	}
}

function validarDecimal(text){
    
    var exprEmpty = /^\s+$/;
	if (exprEmpty.test(text)) {
		return false;
	}
	
	if (text == 127 | text == 8 | text == 0) {
		if (!text.includes(".") && !text.includes(" ")) {
			return true;
		}
	}
	
    if (text == 8 || text == 46 || text == 37 || text == 39) {
    	return true;
	}
    
    var regex = /^[0-9]{1,9}(\.([0-9]{1,2})?)?$/g;
    return regex.test(text);
}

function validarDecimalKeyDown(element){

    var valueBefore = $(element).val();
	setTimeout(function() {
		var data = $(element).val();
		var isOk = validarDecimal(data);

		if (!isOk) {
			if (validarDecimal(valueBefore)) {
				$(element).val(valueBefore);
			}
		}
	}, 20);
}

function addEventDecimalValidation(input) {
	$(input).keydown(function(e) {
		return validarDecimalKeyDown(this);
	});
	
	$(input).on("keypress", function(event){
		var arroba = '64';
		if(event.charCode == arroba){
			return false;
		}else {
			return true;
		}
	});
}

function addEventDecimalValidationFixed(input) {
	$(input).on("keypress", function(e) {
		var arroba = '64';
		if(event.charCode == arroba){
			return false;
		}else {
			return validarDecimalKeyPressAfterInsert(e, this);
		}
	});
}

function validarDecimalChangeRate(text){
    
    var exprEmpty = /^\s+$/;
	if (exprEmpty.test(text)) {
		return false;
	}
	
	if (text == 127 | text == 8 | text == 0) {
		if (!text.includes(".") && !text.includes(" ")) {
			return true;
		}
	}
	
    if (text == 8 || text == 46 || text == 37 || text == 39) {
    	return true;
	}
    
    var regex = /^[0-9](\.([0-9]{1,4})?)?$/g;
    return regex.test(text);
}

function validarDecimalChangeRateKeyDown(element){

    var valueBefore = $(element).val();
	setTimeout(function() {
		var data = $(element).val();
		var isOk = validarDecimalChangeRate(data);

		if (!isOk) {
			if (validarDecimalChangeRate(valueBefore)) {
				$(element).val(valueBefore);
			}
		}
	}, 20);
}

function addEventDecimalChangeRateValidation(input) {
	$(input).keydown(function(e) {
		return validarDecimalChangeRateKeyDown(this);
	});
}

function addEventNumericValidation(input, length) {
	$(input).keydown(function(e) {
		return validateNumberKeyDown(this, length);
	});
}

function addEventAlphaNumericValidation(input, length, exceptions) {

	var accept_space = exceptions.space != undefined ? exceptions.space : false;
	
	$(input).keydown(function(e) {

		if (allowSpecialCharacters(e)) {
			return true;
		} else {
			var limite =  $(this).val().length < length ? true : false;
			if (limite) {
				return validarAlfanumericosKeyDown(this , accept_space);
			} else {
				return false;
			}
		}
		
	});

}
	
	
function validateCCIKeyDown(idInput) {
	var valueBefore = $(idInput).val();
	var valueBeforeLength = valueBefore.length;

	setTimeout(function() {
		var valueAfter = $(idInput).val();
		var valueAfterLength = valueAfter.length;

		
		if (valueBeforeLength == 0 || valueAfterLength > valueBeforeLength) {

			if (valueAfterLength < 3) {

				var isNumeric = validateNumeric(valueAfter);

				if (isNumeric) {
						$(idInput).val(valueAfter);
				} else
					$(idInput).val(valueBefore);
			}
			else if (valueAfterLength == 3) {
				var first_val = valueAfter.substring(0, 3);
				var separator = valueAfter.substring(4);
				var isNumericFirstPart = validateNumeric(first_val);

				if (isNumericFirstPart) {
					$(idInput).val(first_val + '-');
				} else
					$(idInput).val(valueBefore);

			}
			else if (valueAfterLength == 4) {
				var first_val = valueAfter.substring(0, 3);
				var second_val = valueAfter.substring(3);

				if (validateNumeric(first_val) && validateNumeric(second_val)) {
					$(idInput).val(first_val + '-' + second_val);
				} else
					$(idInput).val(valueBefore);

			}
			else if (valueAfterLength >= 5 && valueAfterLength < 7) {
				var first_val = valueAfter.substring(0, 3);
				var separator = valueAfter.substring(3);
				var second_val = valueAfter.substring(4, 7);
				var isNumeric = validateNumeric(second_val);

				if (isNumeric) {
					$(idInput).val(valueAfter);
				} else
					$(idInput).val(valueBefore);
			}

			else if (valueAfterLength == 7) {

				var first_val = valueAfter.substring(0, 3);
				var second_val = valueAfter.substring(4, 7);
				var isNumericFirstPart = validateNumeric(first_val);
				var isNumericSecondPart = validateNumeric(second_val);

				if (isNumericSecondPart && isNumericFirstPart) {
					$(idInput).val(valueAfter + '-');
				} else
					$(idInput).val(valueBefore);

			}
			else if (valueAfterLength == 8) {
				var first_val = valueAfter.substring(0, 3);
				var second_val = valueAfter.substring(4,7);
				var third_val = valueAfter.substring(7);

				if (validateNumeric(first_val) && validateNumeric(second_val) && 
						validateNumeric(third_val)) {
					$(idInput).val(first_val + '-' + second_val + "-" + third_val);
				} else
					$(idInput).val(valueBefore);
			} else if (valueAfterLength > 8 && valueAfterLength < 20) {
				
				var first_val = valueAfter.substring(0, 3);
				var second_val = valueAfter.substring(4, 7);
				var third_val = valueAfter.substring(8, 20);

				if (validateNumeric(first_val) && validateNumeric(second_val) && validateNumeric(third_val)) {
						$(idInput).val(valueAfter);
				} else
					$(idInput).val(valueBefore);
			}
			else if (valueAfterLength == 20) {
				
				if(REG_EXPR_ONLY_NUMERIC.test(valueAfter)){
					var firstPart = valueAfter.substring(0, 3);
					var secondPart = valueAfter.substring(3, 6);
					var thirdPart = valueAfter.substring(6, 18);
					var fourthPart = valueAfter.substring(18, 20);
					
					var cciFormated = firstPart + "-" + secondPart + "-" + thirdPart + "-" + fourthPart;
					$(idInput).val(cciFormated);
				} else {
				var first_val = valueAfter.substring(0, 3);
				var separator = valueAfter.substring(4);
				var second_val = valueAfter.substring(4, 7);
				var separator2 = valueAfter.substring(8);
				var third_val = valueAfter.substring(8, 20);
				
				var isNumericFirstPart = validateNumeric(first_val);
				var isNumericSecondPart = validateNumeric(second_val);
				var isNumericThirdPart = validateNumeric(third_val);

					if (isNumericSecondPart && isNumericFirstPart && isNumericThirdPart) {
						$(idInput).val(valueAfter + '-');
					} else{
						$(idInput).val(valueBefore);
					}
				}

			}
			else if (valueAfterLength == 21) {
				var first_val = valueAfter.substring(0, 3);
				var second_val = valueAfter.substring(4, 7);
				var third_val = valueAfter.substring(8, 20);
				var fourth_val = valueAfter.substring(20);

				if (validateNumeric(first_val) && validateNumeric(second_val) && 
						validateNumeric(third_val) && validateNumeric(fourth_val)) {
					$(idInput).val(first_val + '-' + second_val + "-" + third_val + "-" + fourth_val);
				} else
					$(idInput).val(valueBefore);

			}else if (valueAfterLength > 21 && valueAfterLength <= 23) {
				
				var first_val = valueAfter.substring(0, 3);
				var second_val = valueAfter.substring(4, 7);
				var third_val = valueAfter.substring(8, 20);
				var fourth_val = valueAfter.substring(21);

				if (validateNumeric(first_val) && validateNumeric(second_val) && validateNumeric(third_val) 
						&& validateNumeric(fourth_val) ) {
						$(idInput).val(valueAfter);
				} else
					$(idInput).val(valueBefore);
			}
			
			
		}
		else {
			if (valueAfterLength == 4) {
				var val = valueAfter.substring(0, 3);
				$(idInput).val(val);
			}
			else if (valueAfterLength == 8) {
				var firstPart = valueAfter.substring(0, 3);
				var secondPart = valueAfter.substring(4, 7);
				$(idInput).val(firstPart + '-' + secondPart);
			}
			else if (valueAfterLength == 21) {
				var firstPart = valueAfter.substring(0, 3);
				var secondPart = valueAfter.substring(4, 7);
				var thirdPart = valueAfter.substring(8, 20);
				
				$(idInput).val(firstPart + '-' + secondPart + '-' + thirdPart);
			}else if(valueAfterLength == 20){
				if(REG_EXPR_ONLY_NUMERIC.test(valueAfter)){
					var firstPart = valueAfter.substring(0, 3);
					var secondPart = valueAfter.substring(3, 6);
					var thirdPart = valueAfter.substring(6, 18);
					var fourthPart = valueAfter.substring(18, 20);
					
					var cciFormated = firstPart + "-" + secondPart + "-" + thirdPart + "-" + fourthPart;
					$(idInput).val(cciFormated);
				}
			}
		}

	}, 40);
	
}
function activeRequiredForm(form_name){
	var tempForm = $(form_name + ' input.required-val'),
		tempFormSelect = $(form_name + ' select.required-val'),
		tempButton = $(form_name + ' button.btn');
	
	isEmptyForm(form_name,tempForm,tempFormSelect, tempButton);

	tempForm.blur(function () {
		isEmptyForm(form_name,tempForm,tempFormSelect, tempButton);
	});

	tempForm.keyup(function() {
		isEmptyForm(form_name,tempForm,tempFormSelect, tempButton);
	});	

	tempForm.change(function(){
		isEmptyForm(form_name,tempForm,tempFormSelect, tempButton);
	})
}
function isEmptyForm(formName,form_input,form_Select, button_name){
	var empty_input = false,
		empty_select = false,
		ctrl_input = form_input,
		ctrl_select = form_Select;
	var boolLenghtError = $(formName).find("label.error").length > 0 ? true : false;
	if( ctrl_input.is('input') ) {
		form_input.each(function() {
		if ($(this).val().trim() == '') {
			empty_input = true;
		}
		});
	}
	if(ctrl_select.is('select')){
		 form_Select.each(function() {
			var idx = this.selectedIndex;
			if (idx == 0) { empty_select = true; }
		});
	}
	if ((empty_input) || boolLenghtError) { 
		
		button_name.prop('disabled', true).addClass('btn-inactive');
	}else if((ctrl_select.is('select') && empty_select) || boolLenghtError){
		button_name.prop('disabled', true).addClass('btn-inactive');
	} 
	else { button_name.removeAttr('disabled').removeClass('btn-inactive'); }
}
function validateCciValue(cciValue){
	var bank         = cciValue.substring(0, 3);
	var office       = cciValue.substring(3, 6);
	var account      = cciValue.substring(6, 18);
	var controlDigit = cciValue.substring(18, 20);
	var firstControlDigit = getDigitControl(bank.concat(office));
	var secondControlDigit = getDigitControl(account);

	return parseInt(controlDigit.charAt(0)) == parseInt(firstControlDigit) && parseInt(controlDigit.charAt(1)) == parseInt(secondControlDigit)
}

function getDigitControl(stringControl){
	var index = 1;
    var controlDigit = 0;
    var MODULE = 10;
    var strings = [];
    for(var aa=0; aa<stringControl.length; aa++){
    	var character = stringControl.charAt(aa);
    	strings.push(character);
    }

    for(var ii=0; ii<strings.length; ii++){
    	var digit = strings[ii];
        if (index % 2 == 1) {
            var value = (parseInt(digit) * 1);

            controlDigit += value;

        } else {
            var value = (parseInt(digit) * 2);

            if (String(value).length > 1) {
            	var values = [String(value).charAt(0), String(value).charAt(1)];
            	for(var jj=0; jj<values.length; jj++){
            		var val = values[jj];
                    controlDigit += parseInt(String(val));
                }
            } else {
                controlDigit += value;
            }
        }
        index++;
    }

    controlDigit = MODULE - (controlDigit % MODULE);

    var controlDigitString = String(controlDigit);
    if (controlDigitString.length > 1) {
        controlDigit = parseInt(controlDigitString.substring(controlDigitString.length - 1, controlDigitString.length));
    }

    return controlDigit;
}

function validarAlfanumericosWithPointPaste(tecla, space_accept) {

	var exprEmpty = /^\s+$/;
	if (exprEmpty.test(tecla)) {
		return false;
	}
	if (tecla == 127 | tecla == 8 | tecla == 0) {
		if (!space_accept && tecla.includes(" ")) {
			return false;
		}

		if (tecla.indexOf('.') > -1)
			return false;

		return true;
	}
	var expr = REG_EXPR_ALPHANUMERIC_NO_SPACE_POINT;
	if (space_accept !== undefined && space_accept) {
		expr = REG_EXPR_ALPHANUMERIC_WITH_SPACE_POINT;
	}

	var testExpr = expr.test(tecla);

	return testExpr;
}

function validarAlfanumericosWithPointKeyDown(idInput, space_accept) {
	var valueBefore = $(idInput).val();
	setTimeout(function() {
		var data = $(idInput).val();
		var isOk = validarAlfanumericosWithPointPaste(data, space_accept);
		if (!isOk) {
			$(idInput).val(valueBefore);
		}
	}, 20);
}

function addEventAlphaNumericWithPointValidation(input, length, exceptions) {

	var accept_space = exceptions.space != undefined ? exceptions.space : false;
	
	$(input).keydown(function(e) {

		if (allowSpecialCharacters(e)) {
			return true;
		} else {
			var limite =  $(this).val().length < length ? true : false;
			if (limite) {
				return validarAlfanumericosWithPointKeyDown(this , accept_space);
			} else {
				return false;
			}
		}
		
	});

}

function validateNumberInvoice(idInput, space_accept){
	
	var valueBefore = $(idInput).val();
	setTimeout(function() {
		var data = $(idInput).val();
		var isOk = validateNumberInvoiceText(data, space_accept);
		if (!isOk) {
			$(idInput).val(valueBefore);
		}
	}, 20);
	
}

function validateNumberInvoiceText(tecla, space_accept) {

	var exprEmpty = /^\s+$/;
	if (exprEmpty.test(tecla)) {
		return false;
	}
	if (tecla == 127 | tecla == 8 | tecla == 0) {
		if (!space_accept && tecla.includes(" ")) {
			return false;
		}

		if (tecla.indexOf('.') > -1)
			return false;

		return true;
	}
	var expr = REG_EXPR_NUMBER_INVOICE_NO_SPACE;
	if (space_accept !== undefined && space_accept) {
		expr = REG_EXPR_NUMBER_INVOICE_WITH_SPACE;
	}

	var testExpr = expr.test(tecla);

	return testExpr;
}

function validationAlphanumericKeyPress(evt){
    if(evt.which == 0 || evt.which ==8){
		return true;
	}
	var theEvent = evt || window.event;
    var theVal = theEvent.target.value;
    var key = theEvent.keyCode || theEvent.which;

    key = String.fromCharCode(key);

    if (key.length == 0) return;
    
    var regex = /^[a-z0-9]+$/i;
    if (!regex.test(key)) {
    	if (theEvent.preventDefault) theEvent.preventDefault();
    	return false;
	}
	return true;
}

function validationSpecialAlphanumericKeyPress(evt){
    if(evt.which == 0 || evt.which ==8){
    	return true;
    }
    var theEvent = evt || window.event;
    var theVal = theEvent.target.value;
    var key = theEvent.keyCode || theEvent.which;

    key = String.fromCharCode(key);

    if (key.length == 0) return;

    //var regex = /^[a-zA-Z\d!@#$%^&*()]+$/;
	var regex = REG_EXPR_SPECIAL_ALPHANUMERIC_NO_SPACE; // TFRC 20260604 - permitir varios caracteres especiales
    if (!regex.test(key)) {
    	if (theEvent.preventDefault) theEvent.preventDefault();
    	return false;
	}
	return true;
}

function validationNumericKeyPress(evt){
    if(evt.which == 0 || evt.which ==8){
		return true;
	}
	var theEvent = evt || window.event;
    var theVal = theEvent.target.value;
    var key = theEvent.keyCode || theEvent.which;

    key = String.fromCharCode(key);

    if (key.length == 0) return;
    
    var regex = /^[0-9.,\b]+$/;
    if (!regex.test(key)) {
        if (theEvent.preventDefault) theEvent.preventDefault();
        return false;
    }
    return true;
}

function validationNumberInvoiceKeyPress(evt, space_accept){
    if(evt.which == 0 || evt.which ==8){
		return true;
	}
	var theEvent = evt || window.event;
    var theVal = theEvent.target.value;
    var key = theEvent.keyCode || theEvent.which;

    key = String.fromCharCode(key);

    if (key.length == 0) return;
    
    var regex = REG_EXPR_NUMBER_INVOICE_NO_SPACE;
    
    if (space_accept !== undefined && space_accept)
    	regex = REG_EXPR_NUMBER_INVOICE_WITH_SPACE;
	
    if (!regex.test(key)) {
        if (theEvent.preventDefault) theEvent.preventDefault();
        return false;
    }
    return true;
}

var swipHandler = {	
	leftSwipeEvts : [],
	rightSwipeEvts : [],
	upSwipeEvts : [],
	downSwipeEvts : [],	
	addEvent : function(type,method){
		switch(type){
			case 'all':
				this.upSwipeEvts.push(method);
				this.downSwipeEvts.push(method);
				this.leftSwipeEvts.push(method);
				this.rightSwipeEvts.push(method);
				break;
			case 'up':
				this.upSwipeEvts.push(method);
				break;
			case 'down':
				this.downSwipeEvts.push(method);
				break;
			case 'left':
				this.leftSwipeEvts.push(method);
				break;
			case 'right':
				this.rightSwipeEvts.push(method);
				break;
		}
	},
	init : function(){
		document.addEventListener('touchstart', handleTouchStart, false);        
		document.addEventListener('touchmove', handleTouchMove, false);

		var xDown = null;                                                        
		var yDown = null;                                                        

		function handleTouchStart(evt) {                                         
		    xDown = evt.touches[0].clientX;                                      
		    yDown = evt.touches[0].clientY;                                      
		};                                                

		function handleTouchMove(evt) {
		    if ( ! xDown || ! yDown ) {
		        return;
		    }

		    var xUp = evt.originalEvent.touches[0].clientX;                                    
		    var yUp = evt.originalEvent.touches[0].clientY;

		    var xDiff = xDown - xUp;
		    var yDiff = yDown - yUp;

		    if ( Math.abs( xDiff ) > Math.abs( yDiff ) ) {/*most significant*/
		        if ( xDiff > 0 ) {
		            /* left swipe */ 
		        	alert("left swipe");
		        	leftSwipeEvts.each(function(item){
		        		item();
		        	})
		        } else {
		            /* right swipe */
		        	alert("right swipe");
		        	rightSwipeEvts.each(function(item){
		        		item();
		        	})
		        }                       
		    } else {
		        if ( yDiff > 0 ) {
		            /* up swipe */ 
		        	alert("up swipe");
		        	upSwipeEvts.each(function(item){
		        		item();
		        	})
		        } else { 
		            /* down swipe */
		        	alert("down swipe");
		        	downSwipeEvts.each(function(item){
		        		item();
		        	})
		        }                                                                 
		    }
		    /* reset values */
		    xDown = null;
		    yDown = null;                                             
		};
	}
}

function validarAlfanumericosWithPointKeyDown(idInput, space_accept) {
	var valueBefore = $(idInput).val();
	setTimeout(function() {
		var data = $(idInput).val();
