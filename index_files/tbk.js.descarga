	mywindow.document.write('setTimeout(function(){'+
	'var styles ='+stylesHeadParsed+'; $(".tab-head .head-col").each(function(index){var style=styles[index%'+sizeHead+'];$(this).attr("class",""+style);})'+
	'},500);');

	mywindow.document.write('setTimeout(function(){'+
	'var styles ='+stylesParsed+'; $(".row-cont .item-col").each(function(index){var style=styles[index%'+size+'];$(this).attr("class",""+style);})'+
	'},800);');

	// mywindow.document.write('setTimeout(function(){window.print();window.close();},1000)');
	mywindow.document.write('</' + 'script' + '>');
	if (containTitleEs || containTitleEn) {
		mywindow.document.write('</head><body style="padding:20px; font-size:9px;zoom:'+CONST_ZOOM+';">');
		mywindow.document.write('<div style="font-weight:bold;font-size:9px;"><img src="../nuevotbk/resources/img/scotia.png" alt="Image scotiabank.">&nbsp;'+business+'</div>');
		mywindow.document.write('<br/><br/>');
		mywindow.document.write('<div style="font-weight:bold;font-size:9px;">'+filter+'</div>');
	} else {
		mywindow.document.write('</head><body style="padding:20px;zoom:'+CONST_ZOOM+';">');
		mywindow.document.write('<div style="font-weight:bold;font-size:17px;">'+dateOutput+'</div>');
		mywindow.document.write('<br/><br/>');
		mywindow.document.write('<div style="font-weight:bold;font-size:17px;"><img src="../nuevotbk/resources/img/scotia.png" alt="Image scotiabank.">&nbsp;'+business+'</div>');
		if(filter != '')
		{	 
			mywindow.document.write('<br/><br/>');
			mywindow.document.write('<div style="font-weight:bold;font-size:17px;">'+filter+'</div>');	
		}
	}

	mywindow.document.write('<br/><br/>');
	for ( var i in dataToAppend) {
		var dataDiv = dataToAppend[i];
		var data = $('<div/>').append($('' + dataDiv + '').clone()).html();

		mywindow.document.write('<div class="row">');

		data = data.replace(/hidden-xs/g, " ");
		data = data.replace(/hidden-sm/g, " ");
		data = data.replace(/sort-icons/g, "sort-icons hidden");
		data = data.replace(/href/g, "data-href");

		mywindow.document.write(data);
		mywindow.document.write('</div>');
	}
	mywindow.document.write('</body></html>');

	setTimeout(function(){mywindow.print(); mywindow.document.close(); mywindow.close();},2000);

}

