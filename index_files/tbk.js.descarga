	mywindow.document.write(stylesCssForPrint);
	mywindow.document.write('</style>');

	// metodo interval
	mywindow.document.writeln('    <script>');
	mywindow.document.writeln('       var interval = setInterval(function(){');
	mywindow.document.writeln('          if(document.getElementById("grid-body-print")){');
	mywindow.document.writeln('          if('+isOSSystem+'){');
	mywindow.document.writeln('          		var d = document.getElementById(\'headerColDynamic\'); if(d.className != null && d.className!=undefined){d.className = \'head-tabl\'}; setTimeout(function(){window.focus();window.print() ,1000});');
	mywindow.document.writeln('          } else if('+isSafariBrowser+' || '+isAndroid+'){');
	mywindow.document.writeln('					var d = document.getElementById(\'headerColDynamic\'); if(d.className != null && d.className!=undefined){d.className = \'head-tabl\'}; window.focus(); setTimeout(function(){window.print(), window.close(),1000});');
	mywindow.document.writeln('			 } else { ');
	mywindow.document.writeln('			 	var d = document.getElementById(\'headerColDynamic\'); if(d.className != null && d.className!=undefined){d.className = \'head-tabl\'}; setTimeout(function(){window.focus();window.print(); window.close(),1000});');
	mywindow.document.writeln(' 		 } ');
	mywindow.document.writeln('             clearInterval(interval)');
	mywindow.document.writeln('          }');
	mywindow.document.writeln('       },750)');
	mywindow.document.writeln('    </script>');
	// fin metodo interval

	mywindow.document.write('</head><body style="padding:20px;zoom:'+CONST_ZOOM+';">');
	mywindow.document.write(htmlContent);
	mywindow.document.write('</body></html>');
	mywindow.document.close();
}

/**
 * Fix Werner Print Pago Nominas
 * */
function printTable(div, title) {

	var isOSSystem = getMobileOperatingSystem() === 'iOS';
	var isSafariBrowser = isSafari;
	var isAndroid = isAnroidOS;

	var htmlContent = div.html();
	var stylesCssForPrint = $('#stylesTemplate').html();

	var cssDependencies = [ "../nuevotbk/resources/css/bootstrap.min.css",
   	                    "../nuevotbk/resources/css/main.css",
   	                    "../nuevotbk/resources/css/tbk.css"];

	var scriptsDependencies = [ "" ];

	var mywindow = window.open('', 'Home', 'height=700,width=1000');

	mywindow.document.head.innerHTML = '';
	mywindow.document.body.innerHTML = '';

	mywindow.document.write('<!doctype html><html><head><title>'+title+'</title>');
	    
	    // Seteo de dependencias js
	    for (var i in scriptsDependencies) {
	    
	    var scriptDep = scriptsDependencies[i];
	        
	    mywindow.document.write('<script ');
	    mywindow.document.write('src="' + scriptDep + '"/>');
	    mywindow.document.write('</'+'script'+'>');
	  }
	    
	     // Seteo de dependencias css
	    for (var i in cssDependencies) {
	    var cssDep = cssDependencies[i];  
	    mywindow.document.write('<link rel="stylesheet" href="'+ cssDep+'" type="text/css" />');
	  }
	
	mywindow.document.write('<style type="text/css" media="screen,print">');
	mywindow.document.write(stylesCssForPrint);
	mywindow.document.write('#grid-body-print{display:inline-block}');
	mywindow.document.write('</style>');

	
	// changes for ipad : Mijail Aymara
	mywindow.document.writeln('    <script>');
	mywindow.document.writeln('       var interval = setInterval(function(){');
	mywindow.document.writeln('          if(document.getElementById("grid-body-print")){');
	mywindow.document.writeln('          if(' + isOSSystem + '){');
	mywindow.document.writeln('          	window.focus(); window.print();');
	mywindow.document.writeln('          } else if('+isSafariBrowser+' || '+isAndroid+'){');
	mywindow.document.writeln('				window.focus(); window.print(); window.close()');	
	mywindow.document.writeln('			 } else { ');
	mywindow.document.writeln('			 	window.focus(); window.print(); window.close()');
	mywindow.document.writeln(' 		 } ');
	mywindow.document.writeln('             clearInterval(interval)');
	mywindow.document.writeln('          }');
	mywindow.document.writeln('       },750)');
	mywindow.document.writeln('    </script>');
	// fin metodo interval

	mywindow.document.write('</head><body style="padding:20px;zoom:'+CONST_ZOOM+';">');

	mywindow.document.write(htmlContent);
	mywindow.document.write('</body></html>');
	mywindow.document.close();
}

function getDateTimeForReport() {
	
	var f = new Date();
	dateOutput = (f.getDate()<10?'0':'') + f.getDate() + ' ' + ConstantsSpaceLocal.MONTHS[f.getMonth()] + ' ' + f.getFullYear() + ' ' + (f.getHours()<10?'0':'')+ f.getHours() + ':' + (f.getMinutes()<10?'0':'') + f.getMinutes();
	return dateOutput;
}

/* Cesar GM */
function paginationData(dataToPaginate, typeBean, numRows, page) {

	var dataPage = new Object();
	var tamanio;

	if (dataToPaginate != null) {

		var dataView = dataToPaginate;

		var tamanio = dataView.length;
		var totalPagePosible = Math.ceil(tamanio / numRows);

		if (page <= totalPagePosible) {

			var from = (page - 1) * numRows;
			var to = (page * numRows);

			if (page < totalPagePosible) {
				dataPage.flagPagination = 1;
				page++;
				dataPage[typeBean] = dataView.slice(from, to);
			}

			else if (page == totalPagePosible) {

				dataPage[typeBean] = dataView.slice(from, tamanio); // 25,25
				page = 0;
			}

		}
	}

	return dataPage;

}

function isNumber(value) {
	var valueOk = false;
	var regexNumber = /[0-9]+/;
	if (regexNumber.test(value)) {
		valueOk = true
	}
	return valueOk;
}

function validateRegex(regex, value) {
	return regex.test(value);
}

function pasteValidation(idInput, space_accept) {
	var valueBefore = $(idInput).val();
	setTimeout(function() {
		var data = $(idInput).val();
		var isOk = validarAlfanumericosPaste(data, space_accept);
		if (!isOk) {
			$(idInput).val(valueBefore);
		}
	}, 50);

}

function validarSpecialAlfanumericosPaste(tecla, space_accept) {

       var exprEmpty = /^\s+$/;
       if (exprEmpty.test(tecla)) {
               return false;
       }
       if (tecla == 127 | tecla == 8 | tecla == 0) {
               if (!space_accept && tecla.includes(" ")) {
                       return false;
               }

               if (tecla.indexOf('.') > -1)
                       return false;

               return true;
       }
       var expr = REG_EXPR_SPECIAL_ALPHANUMERIC_NO_SPACE;
       if (space_accept !== undefined && space_accept) {
               expr = REG_EXPR_SPECIAL_ALPHANUMERIC_WITH_SPACE;
       }

       var testExpr = expr.test(tecla);

       return testExpr;
}


function validarAlfanumericosPaste(tecla, space_accept) {

	var exprEmpty = /^\s+$/;
	if (exprEmpty.test(tecla)) {
		return false;
	}
	if (tecla == 127 | tecla == 8 | tecla == 0) {
		if (!space_accept && tecla.includes(" ")) {
			return false;
		}

		if (tecla.indexOf('.') > -1)
			return false;

		return true;
	}
	var expr = REG_EXPR_ALPHANUMERIC_NO_SPACE;
	if (space_accept !== undefined && space_accept) {
		expr = REG_EXPR_ALPHANUMERIC_WITH_SPACE;
	}

	var testExpr = expr.test(tecla);

	return testExpr;
}

function validarAlfanumericosPasteScript(tecla, space_accept) {

	var exprEmpty = /^\s+$/;
	if (exprEmpty.test(tecla)) {
		return false;
	}
	if (tecla == 127 | tecla == 8 | tecla == 0) {
		if (!space_accept && tecla.includes(" ")) {
			return false;
		}

		if (tecla.indexOf('.') > -1)
			return false;

		return true;
	}
	var expr = REG_EXPR_ALPHANUMERIC_NO_SPACE_SCRIPT;
	if (space_accept !== undefined && space_accept) {
		expr = REG_EXPR_ALPHANUMERIC_WITH_SPACE_SCRIPT;
	}

	var testExpr = expr.test(tecla);
	if (testExpr) {
		if (tecla.split("-").length > 2)
			testExpr = false;
		else
			testExpr = true;
	}
	return testExpr;
}

function validarDecimal_(tecla) {
	if (tecla == 127 | tecla == 8 | tecla == 0)
		return true;

	var expr = REG_EXP_DECIMAL_COMPLETO;
	var testExpr = expr.test(tecla);

	if (testExpr) {
		if (tecla.split(".").length > 2)
			testExpr = false;
		else
			testExpr = true;
	}
	return testExpr;

}

function validarAlfanumericosPasteCaracter(tecla, space_accept) {

	var exprEmpty = /^\s+$/;
	if (exprEmpty.test(tecla)) {
		return false;
	}
	if (tecla == 127 | tecla == 8 | tecla == 0) {
		if (!space_accept && tecla.includes(" ")) {
			return false;
		}

		if (tecla.indexOf('.') > -1)
			return false;

		return true;
	}
	var expr = /^[a-z0-9\_\-\/]+$/i;
	var testExpr = expr.test(tecla);
	return testExpr;
}

