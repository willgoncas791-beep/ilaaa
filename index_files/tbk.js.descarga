	ConstantsSpaceLocal.SEC_CORRELATION_ID_HEADER = "x-correlation-id";

	function generateUUID() { // Public Domain/MIT
	    var d = new Date().getTime();//Timestamp
	    var d2 = ((typeof performance !== 'undefined') && performance.now && (performance.now()*1000)) || 0;//Time in microseconds since page-load or 0 if unsupported
	    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
	        var r = Math.random() * 16;//random number between 0 and 16
	        if(d > 0){//Use timestamp until depleted
	            r = (d + r)%16 | 0;
	            d = Math.floor(d/16);
	        } else {//Use microseconds since page-load if supported
	            r = (d2 + r)%16 | 0;
	            d2 = Math.floor(d2/16);
	        }
	        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
	    });
	}
	
	function uuidv4() {
		var methodRandom;
		if (window.crypto && window.crypto.getRandomValues) {
			return ([1e7]+-1e3+-4e3+-8e3+-1e11).replace(/[018]/g, c =>
				(c ^ window.crypto.getRandomValues(new Uint8Array(1))[0] & 15 >> c / 4).toString(16)
			);
		} else if (window.msCrypto && window.msCrypto.getRandomValues) {
			return ([1e7]+-1e3+-4e3+-8e3+-1e11).replace(/[018]/g, c =>
			(c ^ window.msCrypto.getRandomValues(new Uint8Array(1))[0] & 15 >> c / 4).toString(16)
		);
		} else {
			return generateUUID();
		}
	}

	function sanitizeUUID(uuid){
		return uuid.replace(/[^a-zA-Z0-9\-]/g,'');
	}

	function sanitizeUrl(url) {
		const sanitizedUrl = url.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '');

		const entityMap = {
		  '&': '\u0026',
		  '<': '\u003c',
		  '>': '\u003e',
		  '"': '\u0022',
		  "'": '\u0027',
		  '/': '\u002f'
		};
		return sanitizedUrl.replace(/[&<>"'/]/g, match => entityMap[match]);
	}
	
	const TbkPlanEnum = (function(){
		function createPlan(plan){
			var plan = Object.freeze({
				code: plan
			});
			return {
				code: function(){
					return plan.code;
				}
			}
		}
		const Plans = Object.freeze({
			BUSINESS: createPlan('enterprise'),
			INQUIRY: createPlan('queries'),
			CORPORATE: createPlan('corporate')
		});
		function findByCode(code){
			for(var prop in Plans){
				if(Plans[prop].code() == code) {
					return Plans[prop];
				}
			}
		}
		return Object.freeze({
			BUSINESS: Plans.BUSINESS,
			INQUIRY: Plans.INQUIRY,
			CORPORATE: Plans.CORPORATE,
			current: findByCode(ConstantsThymeleaf.tbkPlan)
		})
	})();
	
	var LoaderComponent = (function(){
		return {
			STATE_ONLY_SHOW: 'onlyShow',
			STATE_ONLY_HIDE: 'onlyHide',
			STATE_DEFAULT: ''
		}
	})();
	
	var SecurityContext = (function(){

		const SEC_CORRELATION_ID = "correlationId";
		const SEC_CORRELATION_ID_HEADER = ConstantsSpaceLocal.SEC_CORRELATION_ID_HEADER;
		
		function isLoaded(){
			return !!localStorage.getItem(SEC_CORRELATION_ID);
		}
		
		function value(){
			return localStorage.getItem(SEC_CORRELATION_ID) || "";
		}
		
		function init() {
			localStorage.removeItem(SEC_CORRELATION_ID);
			if(!!LoginConstants.correlationid) {
				localStorage.setItem(SEC_CORRELATION_ID, LoginConstants.correlationid);
			}
		}
		
		function isValid(corridserver) {
			return value() === corridserver;
		}
		
		function SecurityException(message) {
			this.message = message;
			this.name = "SecurityException";
		}
		
		function submitAudit(corridserver) {
			var attr = {};
			attr['CORRID_RESPONSE'] = corridserver;
			attr['CORRID_STORAGE'] = value();
			var elPageHost = $("#page-host");
			var jsConv = elPageHost.data("agreement");
			var jsUser = elPageHost.data("user-code");
			attr['WEB_USERCODE'] = jsUser;
			attr['WEB_CONTRACT'] = jsConv;
			// TFRC 20240903 - vulnerabilidades de redireccion abierta
			var params = $.param( attr ) || "";
			var qParams = "?" + params;
			var finalLink = "";
			if(qParams.length <= 1){
				finalLink = window.location.origin + "/main/LoginPage";
			}
			else{
				var fullLink = URLRequests.REQUEST_CROSS_SESSION_CORRID + qParams;
				finalLink = window.location.origin + fullLink.substring(2);
			}
			//window.location = URLRequests.REQUEST_CROSS_SESSION_CORRID + "?" + $.param( attr );
			window.open(sanitizeUrl(finalLink), '_self');
			$.fn.modalLoad("show");
			throw new SecurityException("CORRID: Redireccionando a login.");
		}
		
		function handleAuditGen(corridserver) {
			if(!isValid(corridserver)){
				submitAudit(corridserver);
			}
		}
		
		function handleAudit() {
			var corridserver = ConstantsThymeleaf.correlationid;
			handleAuditGen(corridserver);
		}
		
		function handleAuditAjax(xhr) {
			var corridserver = xhr.getResponseHeader(SEC_CORRELATION_ID_HEADER);
			if(corridserver !== "") {
				handleAuditGen(ConstantsThymeleaf.correlationid);
			}
		}
	
		return {
			init: init,
			getName: function(){return SEC_CORRELATION_ID;},
			value: value,
			clear: function(){return localStorage.remove(SEC_CORRELATION_ID);},
			isLoaded: isLoaded,
			isValid: isValid,
			handleAudit: handleAudit,
			handleAuditAjax: handleAuditAjax,
			SecurityException: SecurityException
		}
	
	})();
	
	return {
		uuidv4: uuidv4,
		ConstantsSpaceLocal: ConstantsSpaceLocal,
		TbkPlanEnum: TbkPlanEnum,
		LoaderComponent: LoaderComponent,
		SecurityContext: SecurityContext
	}
	
})();

