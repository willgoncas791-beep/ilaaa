function initDatePicker(idDatePickerView, formatDatePicker, dateView) {

	$(idDatePickerView).datepicker({
		dateFormat : formatDatePicker
	});

	$(idDatePickerView).prop('value', dateView);

	var isLangSpanish = isSpanishLanguage();

	if (isLangSpanish)
		convertCalendarSpanish(idDatePickerView);

}

function validateDateFormat(dateView, formatDate) {

	if (formatDate == ConstantsSpaceLocal.FORMAT_DATE_DDMMYYYY) {
		var expReg = /^(((0[1-9]|[12]\d|3[01])\/(0[13578]|1[02])\/((19|[2-9]\d)\d{2}))|((0[1-9]|[12]\d|30)\/(0[13456789]|1[012])\/((19|[2-9]\d)\d{2}))|((0[1-9]|1\d|2[0-8])\/02\/((19|[2-9]\d)\d{2}))|(29\/02\/((1[6-9]|[2-9]\d)(0[48]|[2468][048]|[13579][26])|((16|[2468][048]|[3579][26])00))))$/g;
		return expReg.test(dateView);
	}

	return false;

}

function validateNumeric(valueInput) {
	var expReg = REG_EXPR_ONLY_NUMERIC;
	return expReg.test(valueInput);
}
function validateDecimal(val)
{
	var array = val.split(POINT);
	if(array.length == 1 || array.length == 2){
		if((array[0]!=CONST_EMPTY) && val.substring(0,1) == CODE_NUMERIC_VALIDATION_ZERO)
			return false
			
		if(array.length == 2){
			if(array[1].length == 2 || array[1].length == 1 || array[1].length == 0)
				return true;
			else
				return false;
		}else
		{
			return true;
		}
	}
	else
		return false;
	//return valueOk;
}
function completarDecimalImporte(val)
{
	var valueComplete = CONST_EMPTY;
	var array = val.split(POINT);
	var valueInt = 0;
	var valueDec = 0;
	if(val.indexOf(POINT) == -1)
		valueDec = CODE_NUMERIC_VALIDATION_ZERO_2;
	else
	{
		if(array[1] == CONST_EMPTY)
			valueDec = CODE_NUMERIC_VALIDATION_ZERO_2;
		else
		{
			if(array[1].length == 1)
				valueDec = array[1].concat(CODE_NUMERIC_VALIDATION_ZERO);
			else
				valueDec = array[1];
		}
	}
	valueInt = parseInt(array[0]).toString();
	valueComplete = valueInt.concat(POINT).concat(valueDec);
	return valueComplete;
}
function validateDecimal_rate(value)
{
	var valueOk = false;
	var regexNumber = /^[0-9]+(\.[0-9]{3,3})?$/;
	if(value!=""){
		if(regexNumber.test(value)){
			if(value.indexOf(POINT)==-1)
			{
				valueOk = false;
			}
			else
				valueOk = true
		}
	}
	else
	{
		valueOk = true;
	}
	return valueOk;
}
function validateFormattZipTxt(value)
{
	var valueOk = false;
	var regexNumber = /(\.rar|\.zip|\.txt)$/i;
	if(value!=""){
		if(regexNumber.test(value)){
			valueOk = true;
		}
		else
			valueOk = false;
	}	
	return valueOk;
}
function fileSinExtension(value)
{
	var position = value.lastIndexOf('.');
	var str = value.substr(0, position);
	return str;
}
function validarDateKeyDown(idInput, format_date) {
	var valueBefore = $(idInput).val();
	var valueBeforeLength = valueBefore.length;

	setTimeout(function() {
		var valueAfter = $(idInput).val();
		var valueAfterLength = valueAfter.length;

		if (valueAfterLength > valueBeforeLength) {

			if (valueAfterLength < 2) {

				var isNumeric = validateNumeric(valueAfter);

				if (isNumeric) {
					var valueAfterToInt = parseInt(valueAfter);
					if (valueAfterToInt <= 31)
						$(idInput).val(valueAfter);

					else
						$(idInput).val(valueBefore);
				} else
					$(idInput).val(valueBefore);
			}

			else if (valueAfterLength == 2) {
				var isNumeric = validateNumeric(valueAfter);
				if (isNumeric) {
					var valueAfterToInt = parseInt(valueAfter);
					if (valueAfterToInt > 0 && valueAfterToInt <= 31)
						$(idInput).val(valueAfter + '/');

					else
						$(idInput).val(valueBefore);
				}

				else
					$(idInput).val(valueBefore);
			}

			else if (valueAfterLength == 3) {
				var day = valueAfter.substring(0, 2);
				var month = valueAfter.substring(2);

				if (month != '/')
					$(idInput).val(day + '/' + month);

				else
					$(idInput).val(day + '/');

			}

			else if (valueAfterLength >= 4 && valueAfterLength < 5) {
				var day = valueAfter.substring(0, 2);
				var month = valueAfter.substring(3);
				var isNumeric = validateNumeric(month);

				if (isNumeric) {
					var valueAfterToInt = parseInt(month);
					if (valueAfterToInt <= 12)
						$(idInput).val(day + '/' + month);

					else
						$(idInput).val(valueBefore);
				} else
					$(idInput).val(valueBefore);
			}

			else if (valueAfterLength == 5) {

				var day = valueAfter.substring(0, 2);
				var month = valueAfter.substring(3);
				var isNumeric = validateNumeric(month);

				if (isNumeric) {
					var valueAfterToInt = parseInt(month);
					if (valueAfterToInt > 0 && valueAfterToInt <= 12)
						$(idInput).val(day + '/' + month + '/');

					else
						$(idInput).val(valueBefore);
				} else
					$(idInput).val(valueBefore);

			}

			else if (valueAfterLength == 6) {
				var day = valueAfter.substring(0, 2);
				var month = valueAfter.substring(3, 5);
				var year = valueAfter.substring(5);

				if (year != '/') {
					var isNumeric = validateNumeric(year);

					if (isNumeric)
						$(idInput).val(day + '/' + month + '/' + year);
					else
						$(idInput).val(valueBefore);
				}

			}

			else if (valueAfterLength >= 7 && valueAfterLength <= 10) {

				if (valueAfterLength == 10) {

					var tmpDateInput = valueAfter;
					var isDateValid = validateDateFormat(tmpDateInput,
							'dd/mm/yyyy');

					if (!isDateValid)
						$(idInput).val('');
				}

				else {

					var day = valueAfter.substring(0, 2);
					var month = valueAfter.substring(3, 5);
					var year = valueAfter.substring(6);

					var isNumeric = validateNumeric(year);

					if (isNumeric)
						$(idInput).val(day + '/' + month + '/' + year);

					else
						$(idInput).val(valueBefore);

				}

			}
		}

		else {

			if (valueAfterLength == 3) {
				var day = valueAfter.substring(0, 2);
				$(idInput).val(day);
			}

			else if (valueAfterLength == 6) {
				var day = valueAfter.substring(0, 2);
				var month = valueAfter.substring(3, 5);
				$(idInput).val(day + '/' + month);
			}

		}

	}, 40);

}

function validarDecimalWithNegativeSignKeyDown(idInput) {
	
	var valueBefore = $(idInput).val();
	
	setTimeout(function() {
		
		var data = $(idInput).val();		
		
		if(data.length == 1){
			
			if(data == '-')
				return true;
		
			else{
				
				var isOk = validateDecimalWithNegativeSignText(data);
				
				if(isOk)
					$(idInput).val(data);
				
				else
					$(idInput).val(valueBefore);
			
			}
			
		}
		
        else{
        	var isOk = validateDecimalWithNegativeSignText(data);
        	
    		if (!isOk) {
    			var valueEval = valueBefore;
    			
    			if(valueEval.charAt(0) == '-'){
        			valueEval = valueBefore.substring(1); 
    			}
    			
    			var isOk2 = validateDecimalWithNegativeSignText(valueEval);    		
    			
    			if(isOk2)
    				$(idInput).val(valueBefore);
    		}
		}
		
	}, 20);
	
}

function validateDecimalWithNegativeSignText(valTexto) {
	var exprEmpty = /^\s+$/;
	if (exprEmpty.test(valTexto)) {
		return false;
	}
	if (valTexto == 127 | valTexto == 8 | valTexto == 0) {
		if (!valTexto.includes(".") && !valTexto.includes(" ")) {
			return true;
		}
	}

	var expr = REG_EXP_DECIMAL_CON_SIGNO_EN_FORMACION;
	return expr.test(valTexto);

}

function validateDecimalAmountWithoutSignKeyDown(idInput){
	
	var valueBefore = $(idInput).val();
	setTimeout(function() {
		var data = $(idInput).val();
		var isOk = validateDecimalAmountWithoutSignText(data);

		if (!isOk) {
			if (validateDecimalAmountWithoutSignText(valueBefore)) {
				$(idInput).val(valueBefore);
			}
		}
	}, 20);
	
}

function validateDecimalAmountWithoutSignText(valTexto) {
	var exprEmpty = /^\s+$/;
	if (exprEmpty.test(valTexto)) {
		return false;
	}
	if (valTexto == 127 | valTexto == 8 | valTexto == 0) {
		if (!valTexto.includes(".") && !valTexto.includes(" ")) {
			return true;
		}
	}

	var expr = REG_EXP_DECIMAL_EN_FORMACION;
	return expr.test(valTexto);

}

function setValidationTextInView(componente, txt) {

	$(componente).removeClass("hidden");
	var color = $(componente).css('color');
	var txtDefault = $(componente).text();

	$(componente).text(txt);
	$(componente).css("color", "#d81e05");

}

function hideValidationTextInView(idInputValidator){
	$(idInputValidator).addClass('hidden');
	$(idInputValidator).text('');
}

/* Cesar GM */

// funcion para validar el tamano minimo de un entrada
function esMinimo(value, minLen) {
	if (value != null && value.length < minLen) {
		return false;
	}
	return true;
}

// Counters Type Caracters
function countCaseChars(str) {
	var count = 0, len = str.length;
	for (var i = 0; i < len; i++) {
		if (/[A-Za-z]/.test(str.charAt(i)))
			count++;
	}
	return count;
}

function countCaseNumber(str) {
	var count = 0, len = str.length;
	for (var i = 0; i < len; i++) {
		if (/[0-9]/.test(str.charAt(i)))
			count++;
	}
	return count;
}

/* Mijail Aymara: Metodo generico de impresion */
function printDynamicDivs(cssDependencies, scriptsDependencies, dataToAppend) {

	var mywindow = window.open('', 'Home', 'height=1000,width=1200');

	mywindow.document.head.innerHTML = '';
	mywindow.document.body.innerHTML = '';

	mywindow.document.write('<html><head>');

	// Seteo de dependencias js
	for ( var i in scriptsDependencies) {

		var scriptDep = scriptsDependencies[i];

		mywindow.document.write('<script ');
		mywindow.document.write('src="' + scriptDep + '"/>');
		mywindow.document.write('</' + 'script' + '>');
	}

	// Seteo de dependencias css
	for ( var i in cssDependencies) {
		var cssDep = cssDependencies[i];
		mywindow.document.write('<link rel="stylesheet" href="' + cssDep
				+ '" type="text/css" />');
	}

	mywindow.document
			.write('<style type="text/css" media="print">@page{ margin: 0; } @media print{}</style>');

	mywindow.document.write('<script> ');
	mywindow.document.write('setTimeout(function(){window.print();},1000)');
	mywindow.document.write('</' + 'script' + '>');
	mywindow.document.write('</head><body style="padding:20px;zoom:'+CONST_ZOOM+';">');

	for ( var i in dataToAppend) {
		var dataDiv = dataToAppend[i];
		var data = $('<div/>').append($('' + dataDiv + '').clone()).html();
		mywindow.document.write('<div class="row">');
		if (dataDiv === "#dataUser") {
			mywindow.document
					.write('<div class="col-xs-6 col-md-6" style="font-weight:bold;font-size:17px;"><img src="../nuevotbk/resources/img/scotia.png" alt="Image scotiabank."></div>');
			data = data.replace("hidden-xs", "pull-right");
		} else {
			data = data.replace(/hidden-xs/g, " ");
		}

		data = data.replace(/hidden-sm/g, " ");
		data = data.replace(/col-md/g, "col-xs");
		data = data.replace(/money-containers-flyout/g, " ");

		mywindow.document.write(data);
		mywindow.document.write("<br>");
		mywindow.document.write('</div>');
	}
	mywindow.document.write('</body></html>');
}

