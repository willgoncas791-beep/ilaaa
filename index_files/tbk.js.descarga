	}


	mywindow.document.write('.list-desktop {background: #fff !important;-webkit-print-color-adjust: exact !important;}.row-cont:nth-child(even) {background: #f5f5f5 !important;-webkit-print-color-adjust: exact !important;}}</style>');
	mywindow.document.write('<style type="text/css" media="print">@page{ margin: 0; } @media print{}</style>'); 

