/*
 * Mijail Aymara: Metodo utilitario para validacion de 2 fechas : Los parametros
 * son Id Fecha de inicio y Id Fin
 */
function validarRangoFechasGeneral(idFechaInicio, idFechaFin) {
	var actualDate = new Date();
	var actualYear = actualDate.getFullYear();
	var actualMonth = actualDate.getMonth();
	var actualDay = actualDate.getDate();

	$(idFechaInicio).datepicker({
		dateFormat : 'dd/mm/yy',
		maxDate : new Date(actualYear, actualMonth, actualDay),
		onSelect : function(arg) {

			$(this).removeAttr("placeholder");
			try{
				var fechaInicioMaximo = $(idFechaFin).datepicker('getDate');
				if(fechaInicioMaximo != null){
					fechaInicioMaximo.setDate(fechaInicioMaximo.getDate());
					$(idFechaInicio).datepicker('option', 'maxDate', fechaInicioMaximo);
	
					/** Fix: Para cuando se ingresa una fecha con formato incorrecto en input "fecha desde" **/
					var tmpFechaInicio = $(idFechaInicio).val();
	
					if(tmpFechaInicio == null || tmpFechaInicio.trim() == ""){
						$(idFechaInicio).val($(idFechaFin).val());
					}
					else{
	
						var splitFechaInicio = ($(idFechaInicio).val()).split('/');
						var dayFechaInicio = splitFechaInicio[0];
						var monthFechaInicio = splitFechaInicio[1];
						var yearFechaInicio = splitFechaInicio[2];
	
						if(dayFechaInicio > 31 || monthFechaInicio > 12 || yearFechaInicio > 2027){
							$(idFechaInicio).val($(idFechaFin).val());
						}            	
					}
				}
			}catch(e){
				console.error(e)
			}
            /** Para cuando se ingresa una fecha con formato incorrecto en fecha desde **/

		}
	});

	$(idFechaFin)
			.datepicker(
					{
						dateFormat : 'dd/mm/yy',
						maxDate : new Date(actualYear, actualMonth, actualDay),
						onSelect : function(arg) {

							$(this).removeAttr("placeholder");
							var fechaInicioMaximo = $(idFechaFin).datepicker(
									'getDate');
							fechaInicioMaximo.setDate(fechaInicioMaximo
									.getDate());
							$(idFechaInicio).datepicker('option', 'maxDate',
									fechaInicioMaximo);

							/**
							 * Fix: Para cuando se ingresa una fecha con formato
							 * incorrecto en input "fecha desde" *
							 */
							var tmpFechaInicio = $(idFechaInicio).val();

							if (tmpFechaInicio == null
									|| tmpFechaInicio.trim() == "") {
								$(idFechaInicio).val($(idFechaFin).val());
							} else {

								var splitFechaInicio = ($(idFechaInicio).val())
										.split('/');
								var dayFechaInicio = splitFechaInicio[0];
								var monthFechaInicio = splitFechaInicio[1];
								var yearFechaInicio = splitFechaInicio[2];

								if (dayFechaInicio > 31
										|| monthFechaInicio > 12
										|| yearFechaInicio > 2027) {
									$(idFechaInicio).val($(idFechaFin).val());
								}

							}
							/**
							 * Para cuando se ingresa una fecha con formato
							 * incorrecto en fecha desde *
							 */

						}
					});

}

/* Mijail Aymara: Metodo para asignar fechas por defecto (hoy dia) */
function getTodayDDMMYYYY() {

	var today = new Date();
	var dd = today.getDate();
	var mm = today.getMonth() + 1;

	var yyyy = today.getFullYear();
	if (dd < 10) {
		dd = '0' + dd
	}
	if (mm < 10) {
		mm = '0' + mm
	}
	today = dd + '/' + mm + '/' + yyyy;

	return today;

}

function setDefaultsDates(idFechaInicio, idFechaFin) {

	$(idFechaInicio).attr('value', getTodayDDMMYYYY());
	$(idFechaFin).attr('value', getTodayDDMMYYYY());

	var isLangSpanish = isSpanishLanguage();

	if (isLangSpanish) {
		convertCalendarSpanish(idFechaInicio);
		convertCalendarSpanish(idFechaFin);
	}

}

