	for ( var i in cssDependencies) {
		var cssDep = cssDependencies[i];
	    mywindow.document.write('<link rel="stylesheet" href="'+cssDep+'" type="text/css" />');
	}

	    if((title == 'del exterior' || title == 'al exterior') || (title == 'from abroad' || title == 'from abroad'))
			mywindow.document.write('<style type="text/css" media="print">@media print { html, body {height: 100%;width:100%; background-color: #fff; !important;-webkit-print-color-adjust: exact !important; }.text{text-align:left !important; -webkit-print-color-adjust: exact !important;} .padi5r {padding: 10px 0px 5px 0px !important;   -webkit-print-color-adjust: exact !important;} .text-center-sm, .list-tabl-row .item-col.info-refe.text-center-sm {text-align: center !important;-webkit-print-color-adjust: exact !important; }.telebanking-cuenta .cuenta-list .head-tabl {text-align: center !important;margin: 0px;background: #F5f5f5;border-top: 1px solid #e2e2e2;-webkit-print-color-adjust: exact !important;}}');
	else if (containTitleEs || containTitleEn) {
			mywindow.document.write('<style type="text/css" media="print">@media print { html, body {height: 100%;width:100%; background-color: #fff; !important;-webkit-print-color-adjust: exact !important; }.text{text-align:left !important; -webkit-print-color-adjust: exact !important;} .padi5r {padding: 10px 0px 5px 0px !important;   -webkit-print-color-adjust: exact !important;} p{margin: 0px !important; -webkit-print-color-adjust: exact !important;}.row-cont{padding: 0px 0px 0px 0px !important; -webkit-print-color-adjust: exact !important;}.text-center-sm, .list-tabl-row .item-col.info-refe.text-center-sm {text-align: center !important;-webkit-print-color-adjust: exact !important; }.telebanking-cuenta .cuenta-list .head-tabl {text-align: center !important;margin: 0px;background: #F5f5f5;border-top: 1px solid #e2e2e2;-webkit-print-color-adjust: exact !important;}}');
	} else {
