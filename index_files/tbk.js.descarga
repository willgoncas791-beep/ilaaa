function printDiv(_paramsPrint){
	
	paramsPrint = {
		title : 'Scotiabank',
		width : 800,
		heigth : 600,
		cssLinks : [
	        "../nuevotbk/resources/css/bootstrap.min.css",
	        "../nuevotbk/resources/css/bootstrap-theme.min.css",
	        "../nuevotbk/resources/css/main.css",
	        "../nuevotbk/resources/css/tbk.css",
	        "../nuevotbk/resources/css/print.css"
    	],
		jsLinks : [],
		printMethod : function(callback) {
			callback("HTML POR DEFECTO");
		},
		styleRules : '',
		msgLoader : ConstantsThymeleaf.loading_points,
		msgPrint : ConstantsThymeleaf.printing_points,
		delay : 750,
		delayPrint : 200,
		mode : 'print', // mode [ print | debug ]
		showLoader: true,
		onSuccess: function(){}
	}

	globalMethod.MergeRecursive(paramsPrint,_paramsPrint);
	
	var mywindow = window.open('', paramsPrint.title, 'width='
			+ paramsPrint.width + ',height=' + paramsPrint.heigth);
	if (!mywindow || !mywindow.window || !mywindow.document || !mywindow.document.body) {
		if(mywindow){
			mywindow.close();
		}
		setTimeout(function() {
			printDiv(_paramsPrint);
		}, 750);
	} else {
		mywindow.document.head.innerHTML = '';
		mywindow.document.body.innerHTML = '';
		mywindow.document.title = paramsPrint.title;
		mywindow.document.open();
		
		mywindow.document.writeln('<!doctype html>');
		mywindow.document.writeln('<html>');
		mywindow.document.writeln('  <head>');
		mywindow.document.writeln('    <title>');
		mywindow.document.writeln(paramsPrint.title);
		mywindow.document.writeln('    </title>');
		mywindow.document.writeln('<meta http-equiv="X-UA-Compatible" content="IE=11; IE=10; IE=9; IE=8; IE=7" />');
		for (i in paramsPrint.cssLinks) {
			mywindow.document.writeln('      <link rel="stylesheet" href="'
					+ paramsPrint.cssLinks[i] + '" type="text/css" />');
		}
		for (i in paramsPrint.jsLinks) {
			mywindow.document.writeln('      <script src="'
					+ paramsPrint.jsLinks[i] + '" />');
		}
		mywindow.document.writeln('    <style>');
		mywindow.document.writeln(paramsPrint.styleRules);
		mywindow.document.writeln('    </style>');
		mywindow.document.writeln('    <script>');
		mywindow.document.writeln('       var interval = setInterval(function(){');
		mywindow.document.writeln('          if(document.getElementById("content-complete")){');
		mywindow.document.writeln('             setTimeout(function(){');
		mywindow.document.writeln('                if("'+paramsPrint.mode+'" === "print"){');
		mywindow.document.writeln('             	   window.print();window.document.close();'+((getMobileOperatingSystem()==='iOS')?'':'window.close();'));
		mywindow.document.writeln('                }');
		mywindow.document.writeln('                clearInterval(interval)');
		mywindow.document.writeln('             },'+paramsPrint.delayPrint+')');
		mywindow.document.writeln('          }');
		mywindow.document.writeln('       },' + paramsPrint.delay + ')');
		mywindow.document.writeln('    </script>');
		mywindow.document.writeln('  </head>');
		mywindow.document.writeln('  <body style="zoom:'+CONST_ZOOM+';">');
		mywindow.document.writeln('    <div id="ajax_loader">');
		mywindow.document.writeln('      <div class="text-center">');
		mywindow.document.writeln('        <img src="../nuevotbk/resources/img/load.gif"></img><br/>');
		mywindow.document.writeln('        <span id="ajax_loader-msg">'+paramsPrint.msgLoader+'</span>');
		mywindow.document.writeln('      </div>');
		mywindow.document.writeln('    </div>');
		mywindow.document.writeln('  </body>');
		mywindow.document.writeln('</html>');

		var intervalClose = setInterval(function() {
			if (mywindow.closed) {
				$.fn.modalLoad('hide');
				paramsPrint.onSuccess();
				clearInterval(intervalClose);
			}else if(paramsPrint.showLoader){
				$.fn.modalLoad('show',paramsPrint.msgPrint);
			}
		}, 1000);

		var intervalInject = setInterval(function() {
			if (mywindow.document.getElementById("ajax_loader") !== null) {
				paramsPrint.printMethod(function(html) {
					mywindow.document.body.innerHTML = "<div id='content-complete'>"
							+ html + "</div>";
				});
				paramsPrint.onSuccess();
				clearInterval(intervalInject);
			} else if (mywindow.closed) {
				paramsPrint.onSuccess();
				clearInterval(intervalInject);
			}
		}, 1000);
	}
}

/*
 * Metodos validacion Cesar GM
 */
function validarAlfanumericos(event, longitud, space_accept) {

	var tecla = (document.all) ? event.keyCode : event.which;
	var te = String.fromCharCode(tecla);
	if (tecla == 127 | tecla == 8 | tecla == 0)
		return true;
	var expr = REG_EXPR_ALPHANUMERIC_NO_SPACE;
	if (space_accept !== undefined && space_accept) {
		expr = REG_EXPR_ALPHANUMERIC_WITH_SPACE;
	}
	var te = String.fromCharCode(tecla);
	var testExpr = expr.test(te);

	var comp = event.target;
	valTexto = comp.value;

	if (longitud !== undefined) {
		if (testExpr) {
			if (valTexto.length < longitud)
				testExpr = true;
			else
				testExpr = false;
		}
	}
	return testExpr;
}

function validarDecimalKeyPress(event, element) {
	var key = String.fromCharCode(!event.charCode ? event.which
			: event.charCode);
	var nuevoValorMostrar = $(element).val() + key;

	var esDecimalFormadoValidoPorPattern = RegExp(REG_EXP_DECIMAL_EN_FORMACION)
			.test(nuevoValorMostrar)
	if (!esDecimalFormadoValidoPorPattern) {
		event.preventDefault();
		return false;
	}
	return true;
}

function validarDecimalKeyPressAfterInsert(event, element) {
	var key = String.fromCharCode(!event.charCode ? event.which
			: event.charCode);
	var nuevoValorMostrar = insertString($(element).val(), key, doGetCaretPosition($(element).prop('id')));

	var esDecimalFormadoValidoPorPattern = RegExp(REG_EXP_DECIMAL_EN_FORMACION)
			.test(nuevoValorMostrar)
	if (!esDecimalFormadoValidoPorPattern) {
		event.preventDefault();
		return false;
	}
	return true;
}

function validarDecimalAmountChargeKeyPress(event, element) {
	var regex = /^[0-9]{1,9}(\.([0-9]{1,2})?)?$/g;
	var tecla = event.keyCode;
	if (tecla == 46 | tecla == 8) {
		return true;
	}
	var key = String.fromCharCode(!event.charCode ? event.which
			: event.charCode);
	var nuevoValorMostrar = $(element).val() + key;
	return regex.test(nuevoValorMostrar);
}

function validarDecimalChangeRateKeyPress(event, element){
	var regex = /^[0-9]{1,3}(\.([0-9]{1,4})?)?$/g;
	var tecla = event.keyCode;
	if (tecla == 46 | tecla == 8) {
		return true;
	}
	var key = String.fromCharCode(!event.charCode ? event.which
			: event.charCode);
	var nuevoValorMostrar = $(element).val() + key;
	return regex.test(nuevoValorMostrar);
}

function isSpanishLanguage() {
	var cssLanguage = $('.language-container a:first').prop('class');
	var posSelectES = cssLanguage.indexOf('select');

	if (posSelectES > 0)
		return true;

	else
