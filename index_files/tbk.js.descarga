//Funcion extraida de multiplica.
function scrollto (hash) {
	$('html, body').animate({
		scrollTop: $(hash).offset().top - 100
	}, 1000);
}

// Funciones para habilitacion de ordenamiento
function sortInView(divColumn, flagLoadMore) {
	var $divSort = divColumn.find('.sort-icons');
	var $tableContainer = $divSort.parents('.table__wrapper');
	var sortColumn = $divSort.data("column");
	var typeColumn = $divSort.data("type");
	var $i = $divSort.find(".glyphicon");
	var $divs = $tableContainer.find(".table__row")

	var query = "[data-column='" + sortColumn + "']";
	$divs.each(function() {
		$(this).data('orderby', $(this).find(query).text().toLowerCase().trim());
	})

	if (!flagLoadMore) {
		var clases = $i.attr("class");
		$tableContainer.find("div.sort-icons i").removeClass(
				"glyphicon-menu-up glyphicon-menu-down glyphicon-order");
		$i.addClass(clases);

		if ((!$i.hasClass("glyphicon-menu-up") && !$i
				.hasClass("glyphicon-menu-down"))
				|| $i.hasClass("glyphicon-menu-down")) {
			sortType = SORT_ASC;
			$i.removeClass("glyphicon-menu-down").addClass(
					"glyphicon-menu-up glyphicon-order");
		} else {
			sortType = SORT_DESC;
			$i.removeClass("glyphicon-menu-up").addClass(
					"glyphicon-menu-down glyphicon-order");
		}

		var htmlOrdered = ordenar($divs, sortColumn, sortType, typeColumn);
		$tableContainer.find(".table__body tbody").html(htmlOrdered);
	} else {
		if ($i.hasClass("glyphicon-menu-up")) {
			sortType = SORT_ASC;
		} else {
			sortType = SORT_DESC;
		}
		$tableContainer.find(".table__body tbody").html(
				ordenar($divs, sortColumn, sortType, typeColumn));

	}
}

/*
 * Funcio'n para ordenar en funcion a una columna y tipo de dato asc o desc
 */
function ordenar($divs, sortColumn, sortType, typeColumn) {
	var $divsOrdenados;

	if (sortType === SORT_ASC) {
		valOrder = -1
	} else {
		valOrder = 1
	}

	$divsOrdenados = $divs
			.sort(function(a, b) {
				var valA = formatSort(typeColumn, $(a).data("orderby"));
				var valB = formatSort(typeColumn, $(b).data("orderby"));
				return (valA > valB) ? -1 * valOrder
						: (valA < valB) ? 1 * valOrder : 0;
			});

	return $divsOrdenados;
}

function formatSort(typeColumn, value) {
	if (typeColumn == "d")// Date
	{
		return parseDate(value);
	}
	if (typeColumn == "f")// Float
	{
		return parseFloat(value);
	}
	return value;// Otros
}

/*
 * Parsea del formato dd/mm/yyy a yyyymmdd eperez: Reemplaza a tbkParseDate
 */
function parseDate(fecha) {
	try {
		var date = fecha.split("/");
		var date = date[2] + date[1] + date[0];
		return date;
	} catch (e) {
		return "";
	}
}

/*
 * Parsea un string en formato #,#.## a number #.## eperez: Reemplaza a
 * tbkParseFloat
 */
function parseFloat(numero) {
	// Esta expresion regular se llevara a una constante al inicio de este
	// archivo par su reutilizacion
	var number = Number(numero.toString().replace(/[^-0-9\.]+/g, ""));
	return number;
}

// Elvis Perez: Funcion para conversion de string a otros tipos.
function convertType(val, type) {
	if (type === ConstantsSpaceLocal.TYPE_FLOAT
			|| type === ConstantsSpaceLocal.TYPE_FLOAT_2) {
		return parseFloat(val);
	} else if (type === ConstantsSpaceLocal.TYPE_DATE
			|| type === ConstantsSpaceLocal.TYPE_DATE_2) {
		return parseDate(val);
	} else if (type === ConstantsSpaceLocal.TYPE_STRING
			|| type === ConstantsSpaceLocal.TYPE_STRING_2)
		return val.toLowerCase();
	return val;
}

function compareType(valA, valB, type, typeOrder){
	valA = convertType(valA,type);
	valB = convertType(valB,type);
	return ( valA > valB ? 1 : valA < valB ? -1 : 0 ) * typeOrder;
}

// Validacion de inputs
function validateInput(input, flag, lenght, validate_function_pattern,
		validateFunction) {
	return validateInputMinMaxLength(input, flag, lenght, lenght,
			validate_function_pattern, validateFunction);
}
function validateInputMinMaxLength(input, flag, minLenght, maxLength,
		validate_function_pattern, validateFunction) {
	if (input.length == 0) {
		if (flag != INPUT_EMPTY) {
			flag = INPUT_REQUIRED;
		}
	} else {
		flag = INPUT_TYPED;
		if (input.length < minLenght) {
			flag = INPUT_LEAST;
		} else if (input.length > maxLength) {
			flag = INPUT_MORE;
		} else if (validate_function_pattern !== undefined) {
			if (!validate_function_pattern(input)) {
				flag = INPUT_INVALID;
			} else {
				if (validateFunction !== undefined) {
					flag = validateFunction();
				} else {
					flag = INPUT_SUCCESS;
				}
			}
		} else {
			flag = INPUT_SUCCESS;
		}
	}
	return flag;
}

// Validar flag y mostrar msg de error
function displayError(div, flag, msg_least, msg_more, msg_invalid,
		msg_required, msgFunction) {
	div.addClass("hidden");
	if (flag != INPUT_SUCCESS && flag != INPUT_EMPTY) {
		div.removeClass("hidden");
		if (flag == INPUT_LEAST) {
			div.html(msg_least);
		} else if (flag == INPUT_MORE) {
			div.html(msg_more);
		} else if (flag == INPUT_INVALID) {
			div.html(msg_invalid);
		} else if (flag == INPUT_REQUIRED) {
			div.html(msg_required);
		} else if (msgFunction !== undefined) {
			div.html(msgFunction(flag));
		}
	}
}

// --- PARSEADOR DE NUMEROS
var parsearNumberToDecimal = function(number, ndecimals) {
	var numberSE = number + '';
	var arrayCharts = numberSE.split('');
	var cZeros = 0

	for (var c = 0; c < arrayCharts.length; c++) {
		if ('0' != arrayCharts[c]) {
			break;
		}
		cZeros++;
	}
	if (cZeros > 0) {
		numberSE = numberSE.substring(cZeros, numberSE.length);
	}

	if (numberSE == null || numberSE.trim() == "") {
		numberSE = "0.00";
	} else {

		if (numberSE.length == 1) {
			return "0.0" + numberSE;
		} else if (numberSE.length == 2) {
			return "0." + numberSE;
		} else if (numberSE.length == 3 && numberSE.indexOf(".") != -1) {
			return "0" + numberSE;
		} else {
			numberSE = addDecimalCustomized(numberSE, ndecimals);
		}
	}

	numberSE = setFormatSpacing(numberSE);
	return numberSE;
}

function addDecimalCustomized(snumber, c) {
	var suBSequence;
	var number;
	if (snumber.indexOf(".") != -1) {
		number = snumber;
	} else {
		suBSequence = snumber.length - c;
		number = snumber.substring(0, suBSequence) + '.'
				+ snumber.substring(suBSequence, snumber.length);
	}

	return number;
}

function setFormatSpacing(number) {

	var start = 0;
	var length = number.length;
	var formattedNumber = '';

	var decimals;
	if (number != null && length > 6) {
		decimals = number.substring(length - 3, length);
		number = number.substring(0, length - 3);

		length = number.length;

		var cycle = parseInt(length / 3);
		var res = length % 3;
		var i;
		for (i = 0; i < cycle; i++) {
			if (i > 0) {
				formattedNumber = formattedNumber
						+ number.substring(start, res) + ",";
			} else if (res != 0) {
				formattedNumber = formattedNumber
						+ number.substring(start, res) + ",";
			}

			start = res;
			res += 3;

			if (i == cycle - 1) {

				formattedNumber = formattedNumber
						+ number.substring(start, res);
				formattedNumber = formattedNumber.concat(decimals);
			}
		}
	}
	if (formattedNumber == null || formattedNumber.trim() == "") {
		return number;
	}

	return formattedNumber;
}

function getTextDecimalFormat(numDecimal) {
	return numDecimal != 0 ? setFormatSpacing("" + numDecimal) : "0.00";
}

function roundDecimal(numDecimal, numDecimales) {
	var factor = Math.pow(10, numDecimales);
	var roundNumDecimal = Math.round(numDecimal * factor) / factor;
	return parseFloat("" + roundNumDecimal).toFixed(numDecimales);
}

function normalizarJson(dataStr) {
	var regex = new RegExp("\"", "g");
	var regex2 = new RegExp("\'", "g");

	var $newDataStr = dataStr.replace(regex2, "\\'");// pasa de ' a \'
	newDataStr = $newDataStr.replace(regex, "'");// pasa de " a '
	return newDataStr;
}

