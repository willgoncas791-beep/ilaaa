$(function() {

	var moment = require('moment');

	// ----- TOKEN DE SESSION EN AJAX -----
	// Elvis Perez: Injectar atributos de seguridad al enviar una llamada ajax.
	var httpToken = ConstantsThymeleaf.CSRF_TOKEN;
	var httpHeader = ConstantsThymeleaf.CSRF_HEADER;
	
	var CONST_CROSS_SESSION = 502;

	$(document).ajaxSend(function(event, jqxhr, settings) {
		var ruc = $("#navbar-collapse-1 .dropdown-toggle.glob-menu.no-navigable.active").next().find("span").text();
		if(!!httpHeader && !!httpToken){
			jqxhr.setRequestHeader(httpHeader, httpToken);
		}
		if(ruc){
			jqxhr.setRequestHeader("X-AUTH-COMPANY", ruc);
		}
		if(ConstantsThymeleaf.X_KEY_AUTH_KEY){
			var xKeyAuth;
			if (typeof (Storage) !== "undefined") {
				xKeyAuth = localStorage.getItem(ConstantsThymeleaf.X_KEY_AUTH_KEY);
			}else{
				xKeyAuth = globalMethod.getCookie(ConstantsThymeleaf.X_KEY_AUTH_KEY);
			}
			if(xKeyAuth){
				jqxhr.setRequestHeader(ConstantsThymeleaf.X_KEY_AUTH_KEY, xKeyAuth);
			}
		}
		var correlationId = tbk.SecurityContext.value();
		if(!!correlationId){
			jqxhr.setRequestHeader('x-correlation-id', correlationId);
		}
	});

	// Elvis Perez: Componente Loader
	$.fn.createLoaderComponent = function(params) {

		var _params = {
			time : 1000,
			message : '',
			state : ''
		}
		$.extend(_params, params);
		var interval = null;
		var component = {
			autoHide : function(callback) {
				var obj = this;
				var timeWaiting = 0;
				clearInterval(interval);
				interval = setInterval(
						function() {
							timeWaiting += _params.time;
							if (document.getElementById("ajax_loader").style.display === 'block'
									|| timeWaiting > 5000) {
								obj.hide();
								clearInterval(interval);
								if (callback) {
									callback();
								}
							}
						}, _params.time);
			},
			setState : function(state) {
				_params.state = state;
				return this;
			},
			setMessage : function(message) {
				_params.message = message;
				return this;
			},
			setTime : function(time) {
				_params.time = time;
				return this;
			},
			getTime : function() {
				return _params.time;
			},
			show : function(mensaje) {
				if (_params.state !== LoaderComponent.STATE_ONLY_HIDE) {
					if (!!mensaje) {
						document.getElementById("ajax_loader-msg").innerHTML = mensaje;
					} else {
						document.getElementById("ajax_loader-msg").innerHTML = _params.message;
					}
					document.getElementById("ajax_loader").style.display = 'block';
				}
			},
			hide : function() {
				if (_params.state !== LoaderComponent.STATE_ONLY_SHOW) {
					document.getElementById("ajax_loader").style.display = 'none';
				}
			},
			isShow : function() {
				return document.getElementById("ajax_loader").style.display == 'block';
			}
		}
		return component;
	}

	$.fn.loaderComponent = $.fn.createLoaderComponent();

	// Accion automatica al salir de pantalla.
	$(window).bind("beforeunload", function() {
		$.fn.loaderComponent.show();
		$("#modalSesionExpire").modal('hide');
		if ($.fn.objectInactiviy) {
			$.fn.objectInactiviy.cancelTimeOutTimer();
		}
	});
	$(window).bind("pageshow", function() {
		$.fn.loaderComponent.hide();
	});
	// ----- CONFIGURACION GLOBAL DEL ERROR AJAX ------

	if(ConstantsThymeleaf.correlationid_ajax_enabled === "true") {
		console.log("Control ajax de correlationid.");
		$(document).ajaxSuccess(function(event, xhr, settings) {
			tbk.SecurityContext.handleAuditAjax(xhr);
		});
	}
	
	// Elvis Perez: Funcion por defecto al ocurrir un error en una peticion
	// ajax.
	$(document).ajaxError(function(event, request, settings) {
		$.fn.modalLoad("hide");
		if (request.status === 403 || request.status === 401) {
			var data = {};
			$.fn.httpData(data);
			$.fn.submitForm(URLRequests.URL_LOGOUT, data);
		}else if(request.status === 501){
			var delay = request.getResponseHeader("delay");
			var mode = request.getResponseHeader("mode");
			if("success" === mode){
				$.fn.modalSuccess(request.responseText, undefined, delay);
			}else{
				$.fn.modalErrorInesperado(request.responseText, undefined, delay);
			}
		}else if(CONST_CROSS_SESSION == request.status){
			$.fn.modalErrorInesperado(ConstantsThymeleaf.unexpected_error_operation);
		}else if(!settings.suppressGlobalErrorHandler){
			$.fn.modalErrorInesperado(ConstantsThymeleaf.unexpected_error_operation);
		}else{
			console.error(event, request, settings);
		}
	});

	// Elvis Perez: Control de Autocierre de sesion
	$.fn.inactivityControl = function($dialog, $inputText, timoutWarning,
			timoutNow, logoutFunction, active, options) {

		var thisObject = {
			warningTimer : null,
			timeoutTimer : null,
			secondsGlobal : timoutNow,
			secondsTimer : null,
			secondsWaiting : null,
			isInactive : false,
			isLive : true
		}
		
		if(options === undefined){options = {};}
		var _options = {
			beforeShow: function(dialog){
				dialog.modal('show');
			}
		}
		$.extend(_options, options);
		
		if (active !== undefined) {
			thisObject.isInactive = !active;
		}

		var ObjectInactivity = {

			// Start warning timer.
			startWarningTimer : function() {
				if (!thisObject.isInactive) {
					thisObject.isLive = true;
					$object = this;
					$object.cancelTimeOutTimer();
					// ---
					thisObject.secondsTimer = timoutWarning;
					thisObject.warningTimer = setInterval(function() {
						console.debug("secondsTimer: " + thisObject.secondsTimer);
						if (--thisObject.secondsTimer <= 0) {
							$object.idleWarning();
							clearInterval(thisObject.warningTimer);
						}
					}, 1000);
				}
			},

			// Reset timers.
			cancelTimeOutTimer : function() {
				$dialog.modal('hide');
				clearInterval(thisObject.warningTimer);
				clearInterval(thisObject.timeoutTimer);
			},
			setInactive : function(inactive) {
				thisObject.isInactive = inactive;
			},
			// Reset timers.
			resetTimeOutTimer : function() {
				this.startWarningTimer();
			},

			// Show idle timeout warning dialog.
			idleWarning : function() {
				$object = this;
				$object.cancelTimeOutTimer();
				// ---
				thisObject.secondsWaiting = thisObject.secondsGlobal;
				$inputText.html(thisObject.secondsGlobal);
				thisObject.timeoutTimer = setInterval(function() {
					console.debug("secondsWaiting: " + thisObject.secondsWaiting);
					thisObject.secondsWaiting = thisObject.secondsWaiting - 1;
					$inputText.html(thisObject.secondsWaiting);
					if (thisObject.secondsWaiting <= 0) {
						$object.idleTimeout();
						clearInterval(thisObject.timeoutTimer);
					}
				}, 1000);
				_options.beforeShow($dialog);
				thisObject.isLive = false;
			},

			// Logout the user.
			idleTimeout : logoutFunction,

			isModalShow : function() {
				return !thisObject.isLive;
			}
		}

		return ObjectInactivity;
	}

	// ------- AMARRAR SCROLL A DIV

	// Elvis Perez: Desplaza un div de forma paralela al scroll de un
	// componente.
	$.fn.configScrollableTable = function(scrollable) {
		$this = $(this);
		$(scrollable).on('scroll', function() {
			st = $(this).scrollLeft();
			$this.css('left', -st);
		});
	}

	// Elvis Perez: Componente Pop Over

	$layer = $("#layer_popover");

	function ocultarPopOver() {
		$layer.hide();
		$(".dropdown.dropdown_custom.open").removeClass("open");
		$(".tbk-popover").slideUp();
	}

	$layer.on("click", function() {
		ocultarPopOver();
	});

	$("body").on("click", ".cajilla a", function() {
		ocultarPopOver();
	});

	$.fn.tbkPopOver = function(callback) {
		$comp = $(this);
		if ($comp.hasClass('dropdown') && $comp.hasClass('dropdown_custom')) {
			$comp.addClass("open");
		} else {
			$comp.removeClass("hidden").addClass("tbk-popover");
			$comp.slideDown();
		}
		$layer.show();
		if (callback) {
			callback();
		}
		return $comp;
	}

	// Elvis Perez: Ordenacion de divs
	$.fn.utilSort = function(params) {
		$rows = $(this);
		var _params = {
			orderType : ConstantsSpaceLocal.ORDER_ASC,
			typeCol : ConstantsSpaceLocal.TYPE_STRING,
			query : "*",
			indexCol : 1
		}
		$.extend(_params, params);
		// Conversion por tipo
		_params.query += ":not(.hide):nth-child(" + _params.indexCol + ")";
		var valOne = $(this).find(_params.query).text().trim();
		$rows.each(function() {
			$(this).data('orderby', $(this).find(_params.query).text().trim());
		});
		$rows.sort(function(a, b) {
			var valA = convertType($(a).data('orderby'), _params.typeCol);
			var valB = convertType($(b).data('orderby'), _params.typeCol);
			return (valA === valB) ? 0 : (valA < valB) ? 1 * _params.orderType
					: -1 * _params.orderType;
		});
		return $rows;
	};

	// ----- REDIRECCIONES --------

	// Lanza el mensaje de error inesperado cuando se presiona el enlace.
