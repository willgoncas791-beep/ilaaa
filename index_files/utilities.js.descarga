						e.preventDefault();
						$.fn
								.modalErrorInesperado(ConstantsThymeleaf.unexpected_error_operation);
					})

	// Elvis Perez: Inhabilita redireccion de enlace.
	$("body").on("click", "a.no-navigable", function(e) {
		e.preventDefault();
	});

	// Elvis Perez: Desactiva el loader luego de enviar a un enlace externo.
	$("body").on("click", "a.redirection-link", function(e) {
		$.fn.desactivateLoader();
	});

	// Luis Llactahuaman.
	$("body").on("click", "a.download-link", function(e) {
		setTimeout(function() {
			$("#ajax_loader").hide();
		}, $(this).data('timeOut'));
	});

	/**
	 * Elvis Perez: Envia todos los atributos data-* a la url especificada en su
	 * atributo href que contenga la etiqueta <a>.
	 * 
	 */
	$("body").on("click", "a.send-data", function(e) {
		e.preventDefault();
		var data = $(this).data();
		var state = data.loaderMode ? data.loaderMode : '';
		delete data.loaderMode;
		$.fn.httpData(data);
		$.fn.submitForm($(this).attr("href"), data);
		$.fn.loaderComponent.setState(state).autoHide();
	});

	// ------- FUNCION GENERICA PARA EXPORTS --------
	// Elvis Perez: Metodo general para exportar reportes.
	$.fn.objectExport = function(params, urlExport) {

		var _params = {
			contentType : contentTypeForNavigator(),
			fileName : null,
			urlExport : urlExport,
			dataExport: null
		};

		$.extend(_params, params);

		var urlExport = _params.urlExport;
		delete _params.urlExport;

		var objectExport = {
			sendTo : function(params) {
				var data = {};
				$.extend(data, _params);
				$.extend(data, params);
				$.fn.httpData(data);
				$.fn.submitForm(urlExport, data);
				$.fn.modalLoad('show');
				$.fn.desactivateLoader();
			},
			appendData : function(data) {
				$.extend(_params, data);
			},
			setContentType : function(value) {
				_params.contentType = value;
			},
			setDataExport : function(value, normalizar) {
				value = normalizarJson(value);
				_params.dataExport = value;
			},
			setFileName : function(value) {
				_params.fileName = value;
			},
			setUrlExport : function(value) {
				urlExport = value;
			},
			debug : function() {
				console.debug(urlExport, _params);
			}
		}

		return objectExport;
	}

	// ------- TERMINOS Y CONDICIONES
	// Elvis Perez: Metodo que recarga contenido de terminos y condiciones.
	$("body").on(
			"show.bs.modal",
